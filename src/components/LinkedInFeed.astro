---
/**
 * =============================================================================
 * File:         LinkedInFeed.astro
 * Written by:   Harry Rogers
 * Date:         October 2026
 * Description:  LinkedIn activity timeline feed component with expandable posts
 * =============================================================================
 */

import { linkedInPosts } from '../data/linkedin';
import { profile } from '../data/profile';

interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;

---

<div class="linkedin-feed">
  <div class="feed-list">
    {linkedInPosts.map((post) => (
      <a
        href={post.postUrl}
        target="_blank"
        rel="noopener noreferrer"
        class:list={['card', 'linkedin-row', { 'is-compact': compact }]}
        aria-label={`View post "${post.title}" on LinkedIn`}
      >
        <div class="row-left">
          <div class="row-meta">
            <span class="badge-pill">{post.category}</span>
            <span class="post-date">{post.formattedDate}</span>
          </div>
          <h4 class="post-title">{post.title}</h4>
          {!compact && <p class="post-snippet">{post.content.slice(0, 130)}...</p>}
        </div>
        <div class="row-arrow" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M7 17L17 7"></path>
            <polyline points="7 7 17 7 17 17"></polyline>
          </svg>
        </div>
      </a>
    ))}
  </div>
</div>

<style>
  .linkedin-feed {
    width: 100%;
  }

  .feed-list {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .linkedin-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.15rem 1.45rem;
    border-radius: 10px;
    text-decoration: none;
    color: var(--text);
    background: var(--surface);
    border: 1px solid var(--border);
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.2s ease, box-shadow 0.2s ease;
    gap: 1.5rem;
  }

  .linkedin-row:hover {
    transform: translateY(-2px);
    border-color: color-mix(in srgb, var(--brand) 65%, var(--border));
    box-shadow: 0 10px 24px -8px rgba(0, 0, 0, 0.12);
  }

  .linkedin-row.is-compact {
    padding: 0.95rem 1.25rem;
  }

  .row-left {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    min-width: 0;
  }

  .row-meta {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    font-size: 0.76rem;
  }

  .post-date {
    color: var(--muted);
    font-size: 0.74rem;
    font-family: var(--font-mono);
  }

  .post-title {
    font-size: 1rem;
    font-weight: 700;
    margin: 0;
    line-height: 1.3;
    color: var(--text);
  }

  .post-snippet {
    font-size: 0.88rem;
    color: var(--muted);
    margin: 0;
    line-height: 1.45;
  }

  .row-arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: var(--surface-2);
    color: var(--brand);
    flex-shrink: 0;
    transition: transform 0.2s ease, background 0.2s ease;
  }

  .linkedin-row:hover .row-arrow {
    transform: translate(2px, -2px);
    background: color-mix(in srgb, var(--brand) 15%, transparent);
  }

  @media (max-width: 640px) {
    .linkedin-row {
      padding: 0.85rem 1rem;
      gap: 0.65rem;
    }
  }
</style>
