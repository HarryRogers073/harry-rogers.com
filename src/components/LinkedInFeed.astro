---
import { linkedInPosts } from '../data/linkedin';
import { profile } from '../data/profile';
---

<div class="linkedin-feed">
  <div class="feed-grid">
    {linkedInPosts.map((post) => (
      <article class="card linkedin-card">
        <div class="card-top">
          <div class="author-row">
            <div class="author-avatar">HR</div>
            <div class="author-meta">
              <span class="author-name">{profile.name}</span>
              <span class="author-sub">Hardware Test &amp; FPGA Verification</span>
            </div>
          </div>
          <span class="badge-pill">{post.category}</span>
        </div>

        <div class="card-content">
          <h4 class="post-title">{post.title}</h4>
          <p class="post-text">{post.content}</p>
        </div>

        <div class="card-tags">
          {post.tags.map((tag) => (
            <span class="tag">#{tag}</span>
          ))}
        </div>

        <div class="card-footer">
          <span class="post-date">{post.formattedDate}</span>
          <a
            href={post.postUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="linkedin-link"
            aria-label={`View post "${post.title}" on LinkedIn`}
          >
            <span>View on LinkedIn</span>
            <svg class="external-icon" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
              <polyline points="15 3 21 3 21 9"></polyline>
              <line x1="10" y1="14" x2="21" y2="3"></line>
            </svg>
          </a>
        </div>
      </article>
    ))}
  </div>
</div>

<style>
  .linkedin-feed {
    width: 100%;
  }

  .feed-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(310px, 1fr));
    gap: 1.5rem;
  }

  .linkedin-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 1.5rem;
    height: 100%;
    position: relative;
    border-radius: 12px;
  }

  .card-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 1rem;
    gap: 0.75rem;
  }

  .author-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .author-avatar {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--brand), #0284c7);
    color: #ffffff;
    font-size: 0.85rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 2px 6px rgba(0, 102, 204, 0.25);
    flex-shrink: 0;
  }

  .author-meta {
    display: flex;
    flex-direction: column;
  }

  .author-name {
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--text);
    line-height: 1.2;
  }

  .author-sub {
    font-size: 0.75rem;
    color: var(--text-muted);
    line-height: 1.2;
    margin-top: 2px;
  }

  .card-content {
    flex-grow: 1;
    margin-bottom: 1rem;
  }

  .post-title {
    font-size: 1.05rem;
    font-weight: 700;
    margin: 0 0 0.5rem 0;
    line-height: 1.35;
    color: var(--text);
  }

  .post-text {
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--text-muted);
    margin: 0;
  }

  .card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-bottom: 1.25rem;
  }

  .card-tags .tag {
    font-size: 0.75rem;
    padding: 0.15rem 0.5rem;
  }

  .card-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
    font-size: 0.85rem;
  }

  .post-date {
    color: var(--text-muted);
    font-weight: 500;
    font-size: 0.8rem;
  }

  .linkedin-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--brand);
    font-weight: 600;
    text-decoration: none;
    font-size: 0.85rem;
    transition: color 0.15s ease, transform 0.15s ease;
  }

  .linkedin-link:hover {
    color: var(--brand-hover, var(--brand));
    text-decoration: underline;
    transform: translateX(2px);
  }

  .external-icon {
    flex-shrink: 0;
  }
</style>
