---
import { linkedInPosts } from '../data/linkedin';
import { profile } from '../data/profile';
---

<div class="linkedin-feed">
  <div class="feed-list">
    {linkedInPosts.map((post) => (
      <a
        href={post.postUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="card linkedin-row"
        aria-label={`View post "${post.title}" on LinkedIn`}
      >
        <div class="row-left">
          <div class="row-meta">
            <span class="badge-pill">{post.category}</span>
            <span class="post-date">{post.formattedDate}</span>
          </div>
          <h4 class="post-title">{post.title}</h4>
          <p class="post-snippet">{post.content.slice(0, 130)}...</p>
        </div>
        <div class="row-arrow" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M7 17L17 7"></path>
            <polyline points="7 7 17 7 17 17"></polyline>
          </svg>
        </div>
      </a>
    ))}
  </div>
</div>

<style>
  .linkedin-feed {
    width: 100%;
  }

  .feed-list {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .linkedin-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.15rem 1.4rem;
    border-radius: 12px;
    text-decoration: none;
    color: var(--text);
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
    gap: 1.5rem;
  }

  .linkedin-row:hover {
    transform: translateY(-2px);
    border-color: var(--brand);
    box-shadow: 0 6px 20px -6px rgba(0, 0, 0, 0.08);
  }

  .row-left {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    min-width: 0;
  }

  .row-meta {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    font-size: 0.78rem;
  }

  .post-date {
    color: var(--muted);
    font-size: 0.75rem;
  }

  .post-title {
    font-size: 1.05rem;
    font-weight: 700;
    margin: 0;
    line-height: 1.3;
    color: var(--text);
  }

  .post-snippet {
    font-size: 0.88rem;
    color: var(--muted);
    margin: 0;
    line-height: 1.45;
  }

  .row-arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--surface-2);
    color: var(--brand);
    flex-shrink: 0;
    transition: transform 0.2s ease, background 0.2s ease;
  }

  .linkedin-row:hover .row-arrow {
    transform: translate(2px, -2px);
    background: color-mix(in srgb, var(--brand) 15%, transparent);
  }

  @media (max-width: 640px) {
    .linkedin-row {
      padding: 1rem;
      gap: 0.75rem;
    }
  }
</style>
