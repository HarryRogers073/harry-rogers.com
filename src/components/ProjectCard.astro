---
import type { CollectionEntry } from 'astro:content';
interface Props { project: CollectionEntry<'projects'>; }
const { project } = Astro.props;
const { title, summary, tags, status, thumbnail, badge } = project.data;
---

<article class="card project">
  {thumbnail && (
    <div class="thumb-container">
      <img src={thumbnail} alt={title} loading="lazy" class="thumb-img" />
      {badge && <span class="award-badge">{badge}</span>}
    </div>
  )}
  <div class="card-body">
    <div class="meta">
      <span class="tag status-tag">{status}</span>
      <span class="muted year">{project.data.date.getFullYear()}</span>
    </div>
    <h3><a href={`/projects/${project.id}`}>{title}</a></h3>
    <p class="muted summary">{summary}</p>
    <ul class="tags">{tags.slice(0, 4).map((t) => <li class="tag">{t}</li>)}</ul>
  </div>
</article>

<style>
  .project {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 0;
    overflow: hidden;
    border-radius: 12px;
    border: 1px solid var(--border);
    background: var(--surface);
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.25s ease, border-color 0.25s ease;
  }
  .project:hover {
    transform: translateY(-5px);
    border-color: color-mix(in srgb, var(--brand) 65%, var(--border));
    box-shadow: 0 16px 36px -12px rgba(0, 0, 0, 0.16);
  }
  .thumb-container {
    position: relative;
    width: 100%;
    height: 230px;
    background: var(--surface-2);
    overflow: hidden;
    border-bottom: 1px solid var(--border);
  }
  .thumb-container::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, color-mix(in srgb, var(--surface) 40%, transparent) 0%, transparent 60%);
    pointer-events: none;
  }
  .thumb-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .project:hover .thumb-img {
    transform: scale(1.04);
  }
  .award-badge {
    position: absolute;
    top: 0.85rem;
    right: 0.85rem;
    z-index: 2;
    background: color-mix(in srgb, var(--surface) 92%, transparent);
    backdrop-filter: blur(8px);
    color: var(--brand);
    font-size: 0.72rem;
    font-family: var(--font-mono);
    font-weight: 700;
    padding: 0.3rem 0.75rem;
    border-radius: 6px;
    letter-spacing: 0.04em;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.12);
    border: 1px solid color-mix(in srgb, var(--brand) 28%, var(--border));
  }
  .card-body {
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }
  .meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.82rem;
    font-family: var(--font-mono);
    margin-bottom: 0.55rem;
  }
  .status-tag {
    text-transform: uppercase;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.05em;
  }
  .year {
    font-size: 0.8rem;
    letter-spacing: 0.04em;
  }
  h3 {
    margin: 0.25rem 0 0.5rem;
    font-size: 1.25rem;
    font-family: var(--font-display, var(--font-sans));
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: -0.01em;
  }
  h3 a {
    color: var(--text);
    text-decoration: none;
  }
  h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .summary {
    flex: 1;
    font-size: 0.92rem;
    line-height: 1.55;
    margin-bottom: 1.25rem;
  }
  .tags {
    margin-top: auto;
  }
</style>
