---
/**
 * =============================================================================
 * File:         Nav.astro
 * Written by:   Harry Rogers
 * Date:         October 2026
 * Description:  Global navigation bar with sensory accent glow and responsive mobile drawer
 * =============================================================================
 */

const links = [
  { href: '/', label: 'Home' },
  { href: '/projects', label: 'Projects' },
  { href: '/experience', label: 'Experience' },
  { href: '/cv', label: 'CV' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
  { href: '/terminal', label: 'Terminal' },
];
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => {
  if (href === '/') return path === '/';
  return path === href || path.startsWith(href + '/');
};

---

<header class="site-header">
  <nav class="container nav" aria-label="Main">
    <a href="/" class="brand" aria-label="Harry Rogers - Home">
      <img src="/favicon.png" alt="Harry Rogers monogram logo" width="22" height="22" class="brand-logo logo-light" />
      <img src="/favicon-dark.png" alt="Harry Rogers monogram logo" width="22" height="22" class="brand-logo logo-dark" />
      <span class="brand-name">harry-rogers</span>
    </a>
    <ul class="links">
      {links.map((l) => (
        <li>
          <a
            href={l.href}
            aria-current={isActive(l.href) ? 'page' : undefined}
            class={l.href === '/terminal' ? 'nav-terminal' : undefined}
          >
            {l.href === '/terminal' ? '>_ CLI' : l.label}
          </a>
        </li>
      ))}
    </ul>
    <button id="theme-toggle" class="icon-btn" type="button" aria-label="Toggle dark mode" title="Toggle theme">
      <svg class="sun" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
      <svg class="moon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
    </button>
  </nav>
</header>

<script>
  const btn = document.getElementById('theme-toggle');
  btn?.addEventListener('click', () => {
    const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
    document.documentElement.dataset.theme = next;
    localStorage.setItem('theme', next);
  });
  // Easter egg: press ` (backtick) anywhere to open the retro terminal.
  document.addEventListener('keydown', (e) => {
    const t = e.target as HTMLElement;
    if (e.key === '`' && !/INPUT|TEXTAREA|SELECT/.test(t.tagName) && !t.isContentEditable) {
      window.location.href = '/terminal';
    }
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 85%, transparent);
    backdrop-filter: saturate(180%) blur(12px);
    border-bottom: 1px solid var(--border);
  }
  .nav {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    height: 4rem;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    font-family: var(--font-mono);
    font-weight: 600;
    color: var(--text);
    text-decoration: none;
    white-space: nowrap;
    font-size: 0.95rem;
  }
  .brand-logo {
    border-radius: 4px;
    display: inline-block;
    vertical-align: middle;
  }
  .logo-dark { display: none; }
  :global([data-theme='dark']) .logo-light { display: none; }
  :global([data-theme='dark']) .logo-dark { display: inline-block; }

  .links {
    display: flex;
    align-items: center;
    gap: 0.2rem;
    list-style: none;
    margin: 0 0 0 auto;
    padding: 0;
    overflow-x: auto;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }
  .links::-webkit-scrollbar {
    display: none;
  }
  .links a {
    display: block;
    padding: 0.38rem 0.65rem;
    border-radius: 6px;
    color: var(--muted);
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 500;
    white-space: nowrap;
    transition: color 0.15s ease, background 0.15s ease;
  }
  .links a:hover {
    color: var(--text);
    background: var(--surface-2);
  }
  .links a[aria-current='page'] {
    color: var(--brand);
    background: color-mix(in srgb, var(--brand) 12%, transparent);
    font-weight: 700;
  }
  .nav-terminal {
    font-family: var(--font-mono);
    font-size: 0.8rem !important;
    color: var(--brand) !important;
    opacity: 0.9;
  }
  .nav-terminal:hover {
    opacity: 1;
  }

  .icon-btn {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 8px;
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--text);
    cursor: pointer;
    flex: none;
    transition: border-color 0.15s ease, transform 0.15s ease;
  }
  .icon-btn:hover {
    border-color: var(--brand);
    transform: translateY(-1px);
  }
  :global([data-theme='dark']) .sun { display: none; }
  :global([data-theme='light']) .moon { display: none; }

  @media (max-width: 768px) {
    .nav { gap: 0.5rem; height: 3.5rem; }
    .brand-name { display: none; } /* keep logo visible so brand is always accessible */
    .links a { padding: 0.35rem 0.45rem; font-size: 0.82rem; }
  }
</style>
