---
const links = [
  { href: '/projects', label: 'Projects' },
  { href: '/blog', label: 'Blog' },
  { href: '/cv', label: 'CV' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
];
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => path === href || path.startsWith(href + '/');
---

<header class="site-header">
  <nav class="container nav" aria-label="Main">
    <a href="/" class="brand"><span class="prompt">&gt;_</span> harry-rogers</a>
    <ul class="links">
      {links.map((l) => (
        <li><a href={l.href} aria-current={isActive(l.href) ? 'page' : undefined}>{l.label}</a></li>
      ))}
    </ul>
    <button id="theme-toggle" class="icon-btn" type="button" aria-label="Toggle dark mode" title="Toggle theme">
      <svg class="sun" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
      <svg class="moon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
    </button>
  </nav>
</header>

<script>
  const btn = document.getElementById('theme-toggle');
  btn?.addEventListener('click', () => {
    const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
    document.documentElement.dataset.theme = next;
    localStorage.setItem('theme', next);
  });
  // Easter egg: press ` (backtick) anywhere to open the retro terminal.
  document.addEventListener('keydown', (e) => {
    const t = e.target as HTMLElement;
    if (e.key === '`' && !/INPUT|TEXTAREA|SELECT/.test(t.tagName) && !t.isContentEditable) {
      window.location.href = '/terminal';
    }
  });
</script>

<style>
  .site-header {
    position: sticky; top: 0; z-index: 50;
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: saturate(180%) blur(10px);
    border-bottom: 1px solid var(--border);
  }
  .nav { display: flex; align-items: center; gap: 1.5rem; height: 4rem; }
  .brand { font-family: var(--font-mono); font-weight: 500; color: var(--text); text-decoration: none; white-space: nowrap; }
  .prompt { color: var(--brand); }
  .links { display: flex; gap: 0.25rem; list-style: none; margin: 0 0 0 auto; padding: 0; overflow-x: auto; }
  .links a { display: block; padding: 0.4rem 0.7rem; border-radius: 8px; color: var(--muted); text-decoration: none; font-size: 0.95rem; font-weight: 500; }
  .links a:hover { color: var(--text); background: var(--surface-2); }
  .links a[aria-current='page'] { color: var(--brand); background: color-mix(in srgb, var(--brand) 10%, transparent); }
  .icon-btn { display: grid; place-items: center; width: 2.25rem; height: 2.25rem; border-radius: 8px; border: 1px solid var(--border); background: var(--surface); color: var(--text); cursor: pointer; flex: none; }
  :global([data-theme='dark']) .sun { display: none; }
  :global([data-theme='light']) .moon { display: none; }
  @media (max-width: 640px) {
    .nav { gap: 0.75rem; }
    .brand { display: none; }
    .links { margin-left: 0; }
    .links a { padding: 0.4rem 0.5rem; font-size: 0.9rem; }
  }
</style>
