    const quoteEl = document.getElementById('fact-quote');
    const attrEl = document.getElementById('fact-attribution');
    const displayBox = document.getElementById('random-fact-display');
    const rootEl = document.getElementById('terminal-root');

    if (rollBtn && quoteEl && attrEl && displayBox) {
