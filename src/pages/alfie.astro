          rootEl.classList.add('screen-rumble');
          setTimeout(() => rootEl.classList.remove('screen-rumble'), 350);
        }

        displayBox.style.opacity = '0.2';
        displayBox.style.filter = 'invert(1) hue-rotate(90deg)';

        setTimeout(() => {
          quoteEl.innerHTML = `“${item.funFact}”`;
          attrEl.innerHTML = `// DECRYPTED: <a href="${LINKEDIN_URL}" target="_blank" rel="noopener" style="color:#22c55e; text-decoration:underline;"><strong>${item.name}</strong></a> [${item.location}] // ERA: ${item.era}`;
          displayBox.style.opacity = '1';
          displayBox.style.filter = 'none';
        }, 180);
      });
    }

    // 3. Screen Glitch Button
    const glitchBtn = document.getElementById('glitch-screen-btn');
    if (glitchBtn && rootEl) {
      glitchBtn.addEventListener('click', () => {
        rootEl.classList.add('violent-glitch');
        setTimeout(() => rootEl.classList.remove('violent-glitch'), 450);
      });
    }

    // 4. Client-side Ambient Surveillance Audio Drone (Web Audio API)
    let audioCtx = null;
    let osc1 = null;
    let osc2 = null;
    let noiseNode = null;
    let gainNode = null;
    let isPlayingAudio = false;

    const audioBtn = document.getElementById('toggle-audio-btn');
    const audioIcon = document.getElementById('audio-icon');
    const audioLabel = document.getElementById('audio-label');

    if (audioBtn) {
      audioBtn.addEventListener('click', () => {
        if (!isPlayingAudio) {
          try {
            audioCtx = new (window.AudioContext || window.webkitAudioContext)();

            // Low frequency 55Hz electrical transformer buzz
            osc1 = audioCtx.createOscillator();
            osc1.type = 'sawtooth';
            osc1.frequency.setValueAtTime(55, audioCtx.currentTime);

            // 110Hz harmonic drone
            osc2 = audioCtx.createOscillator();
            osc2.type = 'sine';
            osc2.frequency.setValueAtTime(110, audioCtx.currentTime);

            // Low pass filter for dark, muddy alleyway drone
            const filter = audioCtx.createBiquadFilter();
            filter.type = 'lowpass';
            filter.frequency.setValueAtTime(160, audioCtx.currentTime);

            gainNode = audioCtx.createGain();
            gainNode.gain.setValueAtTime(0.04, audioCtx.currentTime);

            osc1.connect(filter);
            osc2.connect(filter);
            filter.connect(gainNode);
            gainNode.connect(audioCtx.destination);

            osc1.start();
            osc2.start();

            isPlayingAudio = true;
            if (audioIcon) audioIcon.textContent = '🔊';
            if (audioLabel) audioLabel.textContent = 'DRONE: ACTIVE';
            audioBtn.classList.add('audio-active');
          } catch (e) {
            console.error('Audio synthesis failed', e);
          }
        } else {
          if (osc1) osc1.stop();
          if (osc2) osc2.stop();
          if (audioCtx) audioCtx.close();
          isPlayingAudio = false;
          if (audioIcon) audioIcon.textContent = '🔇';
          if (audioLabel) audioLabel.textContent = 'AUDIO HUM';
          audioBtn.classList.remove('audio-active');
        }
      });
    }

    // 5. Era Filter Logic
    const pills = document.querySelectorAll('.filter-pill');
    const cards = document.querySelectorAll('.evidence-file-card');

    pills.forEach((p) => {
      p.addEventListener('click', () => {
        pills.forEach((x) => x.classList.remove('active'));
        p.classList.add('active');

        const filter = p.dataset.filter;
        cards.forEach((card) => {
          if (filter === 'all' || card.dataset.period === filter) {
            card.style.display = 'flex';
          } else {
            card.style.display = 'none';
          }
        });
      });
    });
  </script>
</BaseLayout>

