<BaseLayout 
  title="The Global Annals of Alfie O'Connor" 
  description="A classified compendium of notable, eccentric, and legendary figures named Alfie O'Connor across world history."
  noindex={true}
>
  <div class="alfie-page">
    
    <!-- Top Classified Banner -->
    <header class="alfie-hero">
      <div class="container">
        <div class="classified-pill">
          <span class="lock-icon">🔒</span>
          <span>RESTRICTED ARCHIVE // DOSSIER #0803 // CLASSIFIED EYES ONLY</span>
        </div>

        <h1 class="hero-title">
          The Chronicles of <br />
          <span class="gradient-name">Alfie O’Connor</span>
        </h1>

        <p class="hero-sub">
          An entirely exhaustive, peer-unreviewed compendium of remarkable navigators, hillside choreographers, 
          clockwork rebels, and modern legends who have carried the venerable name of <strong>Alfie O’Connor</strong> 
          across global history.
        </p>

        <!-- Stats Counter -->
        <div class="alfie-stats">
          <div class="stat-box">
            <span class="stat-num">9</span>
            <span class="stat-label">Alfies Catalogued</span>
          </div>
          <div class="stat-box">
            <span class="stat-num">6</span>
            <span class="stat-label">Continents Traversed</span>
          </div>
          <div class="stat-box">
            <span class="stat-num">684</span>
            <span class="stat-label">Years of Recorded Lore</span>
          </div>
          <div class="stat-box highlight">
            <span class="stat-num">1</span>
            <span class="stat-label">Custom Domain Email</span>
          </div>
        </div>

        <!-- Random Fact Generator CTA -->
        <div class="generator-card">
          <div class="generator-header">
            <div>
              <span class="generator-badge">✨ INTERACTIVE ORACLE</span>
              <h3 class="generator-title">Random Alfie Fact Generator</h3>
            </div>
            <button id="roll-fact-btn" class="btn roll-btn" type="button">
              <span>🎲 Roll for Random Alfie</span>
            </button>
          </div>
          
          <div id="random-fact-display" class="random-fact-box">
            <p class="fact-quote" id="fact-quote">"Press the button above to summon a peer-reviewed snippet of Alfie O’Connor lore from the global registry."</p>
            <p class="fact-attribution" id="fact-attribution">— The Archivist</p>
          </div>
        </div>

      </div>
    </header>

    <!-- Filter Bar & Dossier Grid -->
    <section class="dossiers-section">
      <div class="container">

        <div class="section-top">
          <div>
            <p class="eyebrow">Classified Registry</p>
            <h2>The Global Matrix</h2>
          </div>

          <!-- Era Filter Tabs -->
          <div class="filter-group" role="tablist" aria-label="Filter Alfies by era">
            <button class="filter-btn active" data-filter="all">All Eras (9)</button>
            <button class="filter-btn" data-filter="historical">Pre-1900</button>
            <button class="filter-btn" data-filter="twentieth">20th Century</button>
            <button class="filter-btn" data-filter="modern">Modern Day</button>
          </div>
        </div>

        <!-- Grid of Alfies -->
        <div class="grid grid-2 alfie-grid">
          {alfieDossiers.map((alfie) => (
            <article class="alfie-card card" data-period={alfie.periodType} id={alfie.id}>
              
              <div class="card-header">
                <div class="header-left">
                  <span class="country-flag">{alfie.flag}</span>
                  <div>
                    <h3 class="alfie-name">{alfie.name}</h3>
                    <p class="alfie-meta">
                      <span>{alfie.era}</span> • <span>{alfie.location}</span>
                    </p>
                  </div>
                </div>
                <span class={`status-pill pill-${alfie.periodType}`}>{alfie.badge}</span>
              </div>

              <div class="alfie-role-badge">
                <span class="role-icon">⚡</span>
                <span class="role-text">{alfie.title}</span>
              </div>

              <p class="alfie-summary">{alfie.summary}</p>

              <div class="fact-highlight">
                <div class="fact-title">
                  <span class="lightbulb">💡</span>
                  <strong>Verified Fun Fact</strong>
                </div>
                <p class="fact-body">{alfie.funFact}</p>
              </div>

              <blockquote class="alfie-quote">
                “{alfie.quote}”
              </blockquote>

            </article>
          ))}
        </div>

        <!-- Secret Inbound Dispatch -->
        <div class="alfie-dispatch-box card">
          <div class="dispatch-content">
            <span class="dispatch-icon">📬</span>
            <div>
              <h3>Official Dispatch Channel</h3>
              <p class="dispatch-text">
                Need to transmit priority missives, verify genealogical records, or send high-calibre banter to the reigning Alfie of Sussex?
              </p>
            </div>
          </div>
          <div class="dispatch-action">
            <a href="mailto:alfie@harry-rogers.com" class="btn email-btn">
              <span>Send Message to Alfie@harry-rogers.com →</span>
            </a>
          </div>
        </div>

      </div>
    </section>

  </div>

  <!-- Interactive Script for Filtering and Fact Generator -->
  <script is:inline define:vars={{ dossiersJson: JSON.stringify(alfieDossiers) }}>
    const dossiers = JSON.parse(dossiersJson);

    // 1. Fact Generator Logic
    const rollBtn = document.getElementById('roll-fact-btn');
    const quoteEl = document.getElementById('fact-quote');
    const attrEl = document.getElementById('fact-attribution');
    const factBox = document.getElementById('random-fact-display');

    if (rollBtn && quoteEl && attrEl && factBox) {
      let lastIndex = -1;

      rollBtn.addEventListener('click', () => {
        let nextIndex;
        do {
          nextIndex = Math.floor(Math.random() * dossiers.length);
        } while (nextIndex === lastIndex && dossiers.length > 1);
        lastIndex = nextIndex;

        const picked = dossiers[nextIndex];
        
        // Gentle pulse animation
        factBox.style.opacity = '0.3';
        factBox.style.transform = 'translateY(4px)';

        setTimeout(() => {
          quoteEl.innerHTML = `“${picked.funFact}”`;
          attrEl.innerHTML = `— <strong>${picked.name}</strong> (${picked.location}, ${picked.era})`;
          factBox.style.opacity = '1';
          factBox.style.transform = 'translateY(0)';
        }, 150);
      });
    }

    // 2. Era Filtering Logic
    const filterBtns = document.querySelectorAll('.filter-btn');
    const cards = document.querySelectorAll('.alfie-card');

    filterBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        filterBtns.forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');

        const filterVal = btn.dataset.filter;

        cards.forEach((card) => {
          if (filterVal === 'all' || card.dataset.period === filterVal) {
            card.style.display = 'flex';
          } else {
            card.style.display = 'none';
          }
        });
      });
    });
  </script>
</BaseLayout>

