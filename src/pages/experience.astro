---
import BaseLayout from '../layouts/BaseLayout.astro';
import { profile } from '../data/profile';

const experiences = [
  {
    role: "Hardware Test Engineer & Land IPT Test Point of Contact",
    company: "Chess Dynamics",
    location: "Horsham, West Sussex, UK",
    period: "June 2026 – Present",
    type: "Full-Time Industry",
    badge: "Current Role | Land IPT Test Point of Contact",
    summary: "System-level integration, verification, and environmental qualification for high-precision electro-optical surveillance directors (including the Hawkeye land series), while serving as the primary Test Team Point of Contact for the Land Integrated Portfolio Team (IPT).",
    responsibilities: [
      "Act as the primary Test Team Point of Contact for the Land Integrated Portfolio Team (IPT), directing technical queries, coordinating interdisciplinary engineering reviews, and advising Project Managers and Programme Directors on test feasibility and resource estimation.",
      "Conduct rigorous Factory Acceptance Testing (FAT) on electro-optical director platforms against stringent defence customer specifications, verifying stabilized pan-tilt positioners, daylight HD optics, thermal imagers (cooled MWIR / uncooled LWIR), and eye-safe laser rangefinders (LRF).",
      "Execute board-level diagnostics, signal probing, and fault isolation across multi-layer PCBs, digital video processing pipelines, servo motor drive controllers, and continuous slip-ring communications (RS-422, CAN bus, Gigabit Ethernet).",
      "Perform precision optical boresighting, sensor co-alignment, and laser rangefinder calibration to guarantee sub-milliradian angular pointing precision.",
      "Conduct environmental stress screening (ESS), including environmental thermal chamber soak cycles (-40°C to +70°C) and vibration profiling to validate field survivability under severe operational environments.",
      "Author comprehensive FAT verification documentation, discrepancy logs, and standard operating procedures (SOPs) for production test facilities."
    ],
    skills: ["Land IPT Test Coordination", "Electro-Optic Directors", "Factory Acceptance Testing (FAT)", "Optical Boresighting & Calibration", "Hardware Diagnostics", "Slip-Ring Comms (RS-422, CAN, Ethernet)", "Video Processing Pipelines", "Thermal Soak Screening (-40°C to +70°C)", "Vibration Profiling"]
  },
  {
    role: "Systems Engineer - Integration, Verification & Validation (IV&V)",
    company: "BAE Systems",
    location: "Rochester, Kent, UK",
    period: "June 2024 – June 2025",
    type: "12-Month Industrial Placement",
    badge: "Industrial Placement Commendation",
    summary: "Full-time industrial placement within tier-one defence aerospace systems engineering, focusing on automated verification, requirement compliance, and lab testbench operations.",
    responsibilities: [
      "Engineered modular Python test automation scripts interfacing with lab test equipment via PyVISA and serial protocols, accelerating regression test cycles.",
      "Managed end-to-end requirement traceability across complex avionics subsystems using IBM Engineering Requirements Management DOORS and DXL scripts.",
      "Executed formal verification test procedures on physical and simulated avionics hardware, validating flight-critical subsystems against design baselines.",
      "Identified, documented, and triaged hardware and software defects through formal corporate discrepancy reporting systems.",
      "Collaborated closely with systems architects, hardware design leads, and project managers in daily stand-ups and milestone technical reviews."
    ],
    skills: ["Python Automation", "IBM DOORS (DXL)", "Enterprise Architect", "IV&V Lifecycle", "Avionics Systems", "PyVISA", "Hardware Testbenches", "Requirements Traceability"]
  },
  {
    role: "Co-President, Vice President & Web Architect",
    company: "Brighton Real Ale Society",
    location: "University of Brighton, UK",
    period: "September 2024 – June 2026",
    type: "Executive Leadership & Development",
    badge: "Student Society Leadership",
    summary: "Elected executive leader managing society administration, financial budgeting, large-scale events, and engineering the organization's official web platform.",
    responsibilities: [
      "Directed executive committee operations, organized weekly events for 100+ active members, and liaised with the Brighton Students' Union on safety and event licensing.",
      "Architected, developed, and deployed the official society web platform using Next.js (React 19), Prisma ORM, and Supabase PostgreSQL with automated CI/CD on Vercel.",
      "Implemented member authentication, real-time leaderboard polling, dynamic event calendars, and historical venue archives."
    ],
    skills: ["Executive Leadership", "Next.js", "React", "TypeScript", "Prisma ORM", "PostgreSQL", "Budget Management", "Public Relations"]
  },
  {
    role: "Customer Service Assistant & Team Member",
    company: "bp / M&S Simply Food",
    location: "Brighton & Sussex, UK",
    period: "December 2023 – June 2026",
    type: "Part-Time Employment",
    badge: "Customer Operations",
    summary: "Delivered frontline customer service and operational support in high-volume commercial retail while maintaining full-time academic excellence in engineering.",
    responsibilities: [
      "Provided customer-focused service in a high-turnover retail and forecourt setting, demonstrating exceptional reliability and team coordination.",
      "Managed stock inventory auditing, temperature tracking for fresh food compliance, and cash handling procedures.",
      "Enforced stringent forecourt health, safety, and hazardous materials protocols."
    ],
    skills: ["Customer Communication", "Team Collaboration", "Health & Safety Compliance", "Inventory Management", "Conflict Resolution"]
  },
  {
    role: "Shift Manager",
    company: "McDonald's",
    location: "Eastleigh, Hampshire, UK",
    period: "2021 – 2024",
    type: "Operations & Team Leadership",
    badge: "Operational Leadership",
    summary: "Led and coordinated operational shifts directing teams of up to 30 crew members in a high-tempo, time-critical commercial environment alongside university studies.",
    responsibilities: [
      "Directed front-of-house, kitchen, and drive-thru operations during peak trading hours, managing throughput and service speed under intense pressure.",
      "Oversaw daily shift labor scheduling, station rotations, and task assignments for teams of up to 30 personnel.",
      "Enforced rigorous compliance with food hygiene, health and safety, and food temperature auditing standards.",
      "Managed end-of-day register balancing, safe drops, cash reconciliation, and discrepancy investigations.",
      "Coached, onboarded, and mentored new team members, resolving customer escalations with diplomacy."
    ],
    skills: ["Team Leadership", "Shift Scheduling", "High-Pressure Operations", "Cash Reconciliation", "Customer Conflict Resolution", "Quality & Hygiene Compliance"]
  },
  {
    role: "Bicycle Courier",
    company: "Deliveroo",
    location: "Brighton, UK",
    period: "September 2023 – June 2024",
    type: "Independent Logistics",
    badge: "Urban Logistics",
    summary: "Managed time-critical urban delivery routes across Brighton, maintaining high reliability and navigational efficiency.",
    responsibilities: [
      "Executed on-demand food logistics across complex urban topography under strict delivery time windows.",
      "Maintained professional equipment and sustained high customer satisfaction ratings through rapid, careful transport."
    ],
    skills: ["Time Management", "Route Optimization", "Urban Navigation", "Self-Motivation"]
  },
  {
    role: "Volunteer Computer Refurbisher",
    company: "Jamie's Computers",
    location: "Southampton, UK",
    period: "May 2021 – October 2021",
    type: "Voluntary Engineering Support",
    badge: "Community Hardware Support",
    summary: "Volunteered in hardware diagnostics, component harvesting, and PC refurbishment for local community reuse.",
    responsibilities: [
      "Disassembled, diagnosed, and repaired legacy desktop and laptop computers.",
      "Tested RAM modules, storage drives, and power supplies to salvage reusable components for low-income households and charities.",
      "Performed secure disk wiping and operating system installations."
    ],
    skills: ["PC Hardware Repair", "Component Harvesting", "Hardware Diagnostics", "Secure Data Sanitization"]
  }
];
---

<BaseLayout title="Professional Work Experience" description="Industrial and engineering work experience of Harry Rogers: Hardware Test Engineer at Chess Dynamics and Systems Engineer at BAE Systems.">
  <section class="section">
    <div class="container">
      <div class="header-intro">
        <p class="eyebrow">Career &amp; Industry</p>
        <h1>Professional Work Experience</h1>
        <p class="muted intro">
          From full-time tier-one defence aerospace systems engineering and electro-optical testing in industry, 
          to student executive leadership and frontline customer operations.
        </p>
      </div>

      <div class="experience-list">
        {experiences.map((exp) => (
          <article class="card experience-card">
            <div class="card-top">
              <div class="title-meta">
                <span class="badge-pill">{exp.badge}</span>
                <h2>{exp.role}</h2>
                <p class="company-line">
                  <strong>{exp.company}</strong> • <span>{exp.location}</span>
                </p>
              </div>
              <div class="period-box">
                <span class="period-text">{exp.period}</span>
                <span class="type-text muted">{exp.type}</span>
              </div>
            </div>

            <p class="summary-text">{exp.summary}</p>

            <div class="responsibilities-section">
              <h3>Key Responsibilities &amp; Technical Achievements</h3>
              <ul class="resp-list">
                {exp.responsibilities.map((r) => (
                  <li>{r}</li>
                ))}
              </ul>
            </div>

            <div class="skills-row">
              <span class="skills-label">Core Competencies:</span>
              <ul class="tags">
                {exp.skills.map((s) => (
                  <li class="tag">{s}</li>
                ))}
              </ul>
            </div>
          </article>
        ))}
      </div>

      <!-- Call to Action Box -->
      <div class="card cv-cta-card">
        <div>
          <h3>Looking for a comprehensive breakdown?</h3>
          <p class="muted">Review my verified employment history, educational credentials, and publications on my master CV.</p>
        </div>
        <div class="actions">
          <a class="btn" href="/cv">View Master CV →</a>
          <a class="btn ghost" href={profile.cvPdf} download>Download PDF</a>
        </div>
      </div>

    </div>
  </section>
</BaseLayout>

<style>
  .header-intro { max-width: 48rem; margin-bottom: 3rem; }
  .intro { font-size: 1.15rem; line-height: 1.6; margin-top: 0.5rem; }

  .experience-list {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .experience-card {
    padding: 2.25rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    box-shadow: var(--shadow);
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  .experience-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(0,0,0,0.1);
  }

  .card-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: 1.25rem;
    border-bottom: 1px solid var(--border);
    padding-bottom: 1.5rem;
    margin-bottom: 1.25rem;
  }

  .badge-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    background: var(--surface-2);
    color: var(--brand);
    border: 1px solid var(--border);
    font-size: 0.78rem;
    font-weight: 600;
    padding: 0.25rem 0.75rem;
    border-radius: 9999px;
    margin-bottom: 0.5rem;
    letter-spacing: 0.02em;
    font-family: var(--font-mono);
  }

  .title-meta h2 {
    font-size: 1.5rem;
    margin: 0.25rem 0 0.4rem;
    line-height: 1.3;
    color: var(--text);
  }

  .company-line {
    font-size: 1rem;
    color: var(--muted);
    margin: 0;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    flex-wrap: wrap;
  }

  .company-line strong {
    color: var(--text);
  }

  .period-box {
    text-align: right;
  }

  .period-text {
    display: block;
    font-weight: 700;
    font-size: 1rem;
    color: var(--brand);
    font-family: var(--font-mono);
  }

  .type-text {
    font-size: 0.85rem;
    color: var(--muted);
  }

  .summary-text {
    font-size: 1.05rem;
    line-height: 1.6;
    margin-bottom: 1.5rem;
    color: var(--text);
  }

  .responsibilities-section h3 {
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--muted);
    margin-bottom: 0.75rem;
    font-family: var(--font-mono);
  }

  .resp-list {
    margin: 0 0 1.5rem 1.25rem;
    padding: 0;
    line-height: 1.65;
    color: var(--text);
  }

  .resp-list li {
    margin-bottom: 0.5rem;
  }

  .skills-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
    border-top: 1px solid var(--border);
    padding-top: 1.25rem;
  }

  .skills-label {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--muted);
    font-family: var(--font-mono);
  }

  .cv-cta-card {
    margin-top: 3.5rem;
    padding: 2.25rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1.5rem;
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }

  .cv-cta-card h3 {
    margin: 0 0 0.25rem;
    color: var(--text);
  }

  .cv-cta-card p {
    margin: 0;
    color: var(--muted);
  }

  @media (max-width: 768px) {
    .period-box {
      text-align: left;
    }
    .card-top {
      flex-direction: column;
    }
  }
</style>
