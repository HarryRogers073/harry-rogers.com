---
/**
 * =============================================================================
 * File:         experience.astro
 * Written by:   Harry Rogers
 * Date:         October 2026
 * Description:  Career timeline and professional defense engineering roles at Chess Dynamics
 * =============================================================================
 */

import BaseLayout from '../layouts/BaseLayout.astro';
import { profile, experiences } from '../data/profile';

---

<BaseLayout title="Professional Work Experience" description="Industrial and engineering work experience of Harry Rogers: Hardware Test Engineer at Chess Dynamics and Systems Engineer at BAE Systems.">
  <section class="section">
    <div class="container">
      <div class="header-intro">
        <p class="eyebrow">Career &amp; Industry</p>
        <h1>Professional Work Experience</h1>
        <p class="muted intro">
          From full-time tier-one defence aerospace systems engineering and electro-optical testing in industry, 
          to student executive leadership and frontline customer operations.
        </p>
      </div>

      <div class="experience-list">
        {experiences.map((exp) => {
          const cardId = exp.company.toLowerCase().includes('chess')
            ? 'chess-dynamics'
            : exp.company.toLowerCase().includes('bae')
              ? 'bae-systems'
              : undefined;
          return (
            <article class="card experience-card" id={cardId}>
            <div class="card-top">
              <div class="title-meta">
                <span class="badge-pill">{exp.badge}</span>
                <h2>{exp.role}</h2>
                <p class="company-line">
                  <strong>
                    {exp.company === 'Chess Dynamics' ? (
                      <a href="https://www.chess-dynamics.com" target="_blank" rel="noopener noreferrer" class="company-link">{exp.company} ↗</a>
                    ) : (
                      exp.company
                    )}
                  </strong> • <span>{exp.location}</span>
                </p>
              </div>
              <div class="period-box">
                <span class="period-text">{exp.period}</span>
                <span class="type-text muted">{exp.type}</span>
              </div>
            </div>

            <p class="summary-text">{exp.summary}</p>

            <div class="responsibilities-section">
              <h3>Key Responsibilities &amp; Technical Achievements</h3>
              <ul class="resp-list">
                {exp.responsibilities.map((r) => (
                  <li>{r}</li>
                ))}
              </ul>
            </div>

            <div class="skills-row">
              <span class="skills-label">Core Competencies:</span>
              <ul class="tags">
                {exp.skills.map((s) => (
                  <li class="tag">{s}</li>
                ))}
              </ul>
            </div>

            {exp.company === 'Chess Dynamics' && (
              <div class="card-footer-actions">
                <a
                  href="https://www.chess-dynamics.com/hawkeye-land-systems"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="btn ghost btn-sm"
                  title="View official Hawkeye Land Systems vehicle photos and specifications on Chess Dynamics"
                >
                  View Official Hawkeye Platform Images &amp; Specs ↗
                </a>
              </div>
            )}
          </article>
        );
      })}
      </div>

      <!-- Call to Action Box -->
      <div class="card cv-cta-card">
        <div>
          <h3>Looking for a comprehensive breakdown?</h3>
          <p class="muted">Review my verified employment history, educational credentials, and publications on my master CV.</p>
        </div>
        <div class="actions">
          <a class="btn" href="/cv">View Master CV →</a>
          <a class="btn ghost" href={profile.cvPdf} download>Download PDF</a>
        </div>
      </div>

    </div>
  </section>
</BaseLayout>

<style>
  .header-intro { max-width: 48rem; margin-bottom: 3rem; }
  .intro { font-size: 1.15rem; line-height: 1.6; margin-top: 0.5rem; }

  .experience-list {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .experience-card {
    padding: 2.25rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    box-shadow: var(--shadow);
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  .experience-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(0,0,0,0.1);
  }

  .card-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: 1.25rem;
    border-bottom: 1px solid var(--border);
    padding-bottom: 1.5rem;
    margin-bottom: 1.25rem;
  }

  .badge-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    background: var(--surface-2);
    color: var(--brand);
    border: 1px solid var(--border);
    font-size: 0.78rem;
    font-weight: 600;
    padding: 0.25rem 0.75rem;
    border-radius: 9999px;
    margin-bottom: 0.5rem;
    letter-spacing: 0.02em;
    font-family: var(--font-mono);
  }

  .title-meta h2 {
    font-size: 1.5rem;
    margin: 0.25rem 0 0.4rem;
    line-height: 1.3;
    color: var(--text);
  }

  .company-line {
    font-size: 1rem;
    color: var(--muted);
    margin: 0;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    flex-wrap: wrap;
  }

  .company-line strong {
    color: var(--text);
  }

  .company-link {
    color: var(--text);
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .company-link:hover {
    color: var(--brand);
    text-decoration: underline;
  }

  .period-box {
    text-align: right;
  }

  .period-text {
    display: block;
    font-weight: 700;
    font-size: 1rem;
    color: var(--brand);
    font-family: var(--font-mono);
  }

  .type-text {
    font-size: 0.85rem;
    color: var(--muted);
  }

  .summary-text {
    font-size: 1.05rem;
    line-height: 1.6;
    margin-bottom: 1.5rem;
    color: var(--text);
  }

  .responsibilities-section h3 {
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--muted);
    margin-bottom: 0.75rem;
    font-family: var(--font-mono);
  }

  .resp-list {
    margin: 0 0 1.5rem 1.25rem;
    padding: 0;
    line-height: 1.65;
    color: var(--text);
  }

  .resp-list li {
    margin-bottom: 0.5rem;
  }

  .skills-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
    border-top: 1px solid var(--border);
    padding-top: 1.25rem;
  }

  .skills-label {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--muted);
    font-family: var(--font-mono);
  }

  .card-footer-actions {
    margin-top: 1.25rem;
    padding-top: 1.25rem;
    border-top: 1px dashed var(--border);
    display: flex;
    justify-content: flex-end;
  }

  .btn-sm {
    font-size: 0.82rem;
    padding: 0.4rem 0.9rem;
  }

  .cv-cta-card {
    margin-top: 3.5rem;
    padding: 2.25rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1.5rem;
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }

  .cv-cta-card h3 {
    margin: 0 0 0.25rem;
    color: var(--text);
  }

  .cv-cta-card p {
    margin: 0;
    color: var(--muted);
  }

  @media (max-width: 768px) {
    .period-box {
      text-align: left;
    }
    .card-top {
      flex-direction: column;
    }
  }
</style>
