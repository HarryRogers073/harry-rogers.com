---
/**
 * =============================================================================
 * File:         index.astro
 * Written by:   Harry Rogers
 * Date:         October 2026
 * Description:  Homepage showcasing engineering background, flagship project, and timeline
 * =============================================================================
 */

import BaseLayout from '../layouts/BaseLayout.astro';
import LinkedInFeed from '../components/LinkedInFeed.astro';
import { profile } from '../data/profile';
import { getCollection } from 'astro:content';

const allProjects = await getCollection('projects');
const vaidarProject = allProjects.find((p) => p.id === 'vaidar-hil-framework') || allProjects[0];

---

<BaseLayout>
  <!-- Full-Page Continuous Sensual Floating Lines & Ambient Glow -->
  <canvas id="bg-flow-canvas" class="bg-flow-canvas" aria-hidden="true"></canvas>
  <div class="sensual-ambient-glow" aria-hidden="true"></div>

  <!-- Hero Section: Organic, Human, Clean & Flowing -->
