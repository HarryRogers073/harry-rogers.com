---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import LinkedInFeed from '../components/LinkedInFeed.astro';
import { profile } from '../data/profile';
import { getCollection } from 'astro:content';

const allProjects = await getCollection('projects');
const featuredProjects = allProjects
  .filter((p) => p.data.featured)
  .sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout>
  <!-- Hero Section (Spacious, Clean, Ambient Fade) -->
  <section class="section hero-section">
    <div class="ambient-glow" aria-hidden="true"></div>
    <div class="container hero-container">
      <div class="hero-content">
        <div class="tech-indicator">
          <span class="pulse-dot"></span>
          <span class="tech-indicator-tag">ACTIVE TEST RUNNER</span>
          <span class="tech-indicator-sep">/</span>
          <span class="tech-indicator-sub">CHESS DYNAMICS DEFENCE</span>
        </div>

        <h1 class="hero-title">
          DIGITAL LOGIC <br />
          <span class="gradient-text">&amp; HARDWARE TESTBEDS.</span>
        </h1>

        <p class="hero-subtitle">
          Hi, I’m <strong>Harry Rogers</strong>. I push electro-optical defence platforms and FPGA silicon to physical limits — engineering automated test rigs, sub-microsecond RTL telemetry, and zero-defect verification suites.
        </p>

        <div class="actions">
          <a class="btn" href="/projects">Explore Projects →</a>
          <a class="btn ghost" href="/cv">View Master CV</a>
          <a class="btn ghost" href="/terminal" title="Launch retro terminal">&gt;_ Retro CLI</a>
        </div>
      </div>

      <div class="hero-metrics-card card">
        <div class="metrics-header">
          <span class="metrics-title">ACADEMIC &amp; INDUSTRY DISTINCTIONS</span>
          <span class="metrics-tag">CLASS OF 2026</span>
        </div>
        <ul class="metrics-stats">
          <li>
            <strong class="stat-number">91%</strong>
            <span class="stat-label">Dissertation (A+)</span>
          </li>
          <li>
            <strong class="stat-number">1st</strong>
            <span class="stat-label">BEng Honours</span>
          </li>
          <li>
            <strong class="stat-number brand-accent">IET</strong>
            <span class="stat-label">Prize Winner</span>
          </li>
        </ul>
        <div class="tech-stack-row">
          <span class="tag">Xilinx Vivado</span>
          <span class="tag">Verilog HDL</span>
          <span class="tag">Python HIL</span>
          <span class="tag">MATLAB</span>
          <span class="tag">Electro-Optics</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Portfolio & Technical Case Studies Portal -->
  <section class="section">
    <div class="container">
      <div class="section-header">
        <div>
          <p class="eyebrow">Engineering Work</p>
          <h2>Featured Case Studies</h2>
        </div>
        <a class="view-all" href="/projects">Explore all {allProjects.length} projects →</a>
      </div>

      <!-- Curated top 2 flagship projects as clean preview cards -->
      <div class="grid grid-2">
        {featuredProjects.slice(0, 2).map((project) => (
          <ProjectCard project={project} />
        ))}
      </div>

      <!-- Quick category jump pills to navigate projects subpage -->
      <div class="project-quick-links">
        <a href="/projects#fpga" class="pill-link">FPGA &amp; RTL Verilog →</a>
        <a href="/projects#embedded" class="pill-link">Embedded C &amp; PIC →</a>
        <a href="/projects#hardware" class="pill-link">Autonomous Robotics →</a>
        <a href="/projects#dsp" class="pill-link">MATLAB Telemetry &amp; DSP →</a>
      </div>
    </div>
  </section>

  <!-- Deep Navigation Grid (Sub-Page Portal) -->
  <section class="section">
    <div class="container">
      <div class="section-header">
        <div>
          <p class="eyebrow">Directory</p>
          <h2>Explore The Site</h2>
        </div>
      </div>

      <div class="portal-grid">
        <a href="/experience" class="card portal-card">
          <div class="portal-badge">INDUSTRY</div>
          <h3>Work Experience</h3>
          <p class="muted">Chess Dynamics hardware test engineering &amp; BAE Systems 12-month IV&amp;V placement.</p>
          <span class="portal-cta">View career timeline →</span>
        </a>

        <a href="/cv" class="card portal-card">
          <div class="portal-badge">CREDENTIALS</div>
          <h3>Curriculum Vitae</h3>
          <p class="muted">First-Class Honours degree breakdown, 17 accredited module marks, and downloadable PDF.</p>
          <span class="portal-cta">Open Master CV →</span>
        </a>

        <a href="/about" class="card portal-card">
          <div class="portal-badge">BIOGRAPHY</div>
          <h3>About &amp; Journey</h3>
          <p class="muted">Academic background, IET Prize 2026 award story, and verification engineering philosophy.</p>
          <span class="portal-cta">Read biography →</span>
        </a>

        <a href="/contact" class="card portal-card">
          <div class="portal-badge">CONNECT</div>
          <h3>Get in Touch</h3>
          <p class="muted">Direct verified contact form, email address, and direct messaging channels.</p>
          <span class="portal-cta">Send message →</span>
        </a>
      </div>
    </div>
  </section>

  <!-- LinkedIn Updates & Network -->
  <section class="section">
    <div class="container">
      <div class="section-header">
        <div>
          <p class="eyebrow">Network</p>
          <h2>Recent Updates</h2>
        </div>
        <a class="view-all" href={profile.links.linkedin} target="_blank" rel="noopener noreferrer">
          LinkedIn Profile →
        </a>
      </div>

      <LinkedInFeed />
    </div>
  </section>
</BaseLayout>

<style>
  .hero-section {
    position: relative;
    padding-top: 6rem;
    padding-bottom: 6rem;
    overflow: hidden;
  }
  
  /* Soft ambient radial background fade */
  .ambient-glow {
    position: absolute;
    top: -20%;
    left: 45%;
    transform: translateX(-50%);
    width: 750px;
    height: 550px;
    background: radial-gradient(circle, color-mix(in srgb, var(--brand) 12%, transparent) 0%, color-mix(in srgb, var(--accent) 5%, transparent) 50%, transparent 75%);
    pointer-events: none;
    filter: blur(80px);
    z-index: 0;
  }

  .hero-container {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1.25fr 0.75fr;
    gap: 4rem;
    align-items: center;
  }

  .tech-indicator {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.4rem 0.95rem;
    border-radius: 8px;
    background: var(--surface-2);
    border: 1px solid var(--border);
    margin-bottom: 1.75rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
  }
  .tech-indicator-tag {
    font-weight: 700;
    color: var(--text);
  }
  .tech-indicator-sep {
    color: var(--muted);
    opacity: 0.4;
  }
  .tech-indicator-sub {
    color: var(--muted);
    font-weight: 500;
  }

  .pulse-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #10b981;
    box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.2);
  }

  .hero-title {
    font-family: var(--font-display, var(--font-sans));
    font-size: clamp(2.4rem, 4.8vw, 3.8rem);
    font-weight: 800;
    line-height: 1.08;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    margin-bottom: 1.5rem;
  }
  .gradient-text {
    background: linear-gradient(135deg, var(--brand) 0%, #38bdf8 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .hero-subtitle {
    font-size: 1.15rem;
    color: var(--muted);
    line-height: 1.7;
    max-width: 37rem;
  }

  .hero-metrics-card {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
    padding: 2.25rem;
    border-color: color-mix(in srgb, var(--brand) 20%, var(--border));
    background: var(--surface);
    box-shadow: var(--shadow);
  }
  .metrics-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.75rem;
    font-family: var(--font-mono);
    font-weight: 700;
    letter-spacing: 0.06em;
  }
  .metrics-title { color: var(--muted); }
  .metrics-tag {
    background: color-mix(in srgb, var(--brand) 10%, transparent);
    color: var(--brand);
    padding: 0.15rem 0.5rem;
    border-radius: 4px;
    border: 1px solid color-mix(in srgb, var(--brand) 25%, transparent);
  }

  .metrics-stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    list-style: none;
    padding: 0;
    margin: 0;
    text-align: center;
  }
  .metrics-stats li {
    background: var(--surface-2);
    padding: 0.85rem 0.5rem;
    border-radius: 10px;
    border: 1px solid var(--border);
  }
  .stat-number {
    display: block;
    font-size: 1.85rem;
    font-weight: 800;
    color: var(--text);
    font-family: var(--font-mono);
  }
  .brand-accent { color: var(--brand); }
  .stat-label {
    font-size: 0.75rem;
    text-transform: uppercase;
    color: var(--muted);
    letter-spacing: 0.05em;
    font-weight: 600;
    margin-top: 0.2rem;
  }

  .tech-stack-row { display: flex; flex-wrap: wrap; gap: 0.4rem; }

  .section-header { display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 2rem; }
  .view-all { color: var(--brand); text-decoration: none; font-weight: 600; font-size: 0.95rem; }
  .project-quick-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border);
  }
  .pill-link {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--muted);
    text-decoration: none;
    padding: 0.4rem 0.85rem;
    background: var(--surface-2);
    border-radius: 9999px;
    border: 1px solid var(--border);
    transition: color 0.15s ease, border-color 0.15s ease, transform 0.15s ease;
  }
  .pill-link:hover {
    color: var(--brand);
    border-color: var(--brand);
    transform: translateY(-1px);
  }

  /* Sub-page Navigation Portal Grid */
  .portal-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.75rem;
  }
  .portal-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 2rem 1.85rem;
    border-radius: 12px;
    text-decoration: none;
    color: var(--text);
    background: var(--surface);
    border: 1px solid var(--border);
    position: relative;
    overflow: hidden;
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  }
  .portal-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 3px;
    height: 0;
    background: var(--brand);
    transition: height 0.2s ease;
  }
  .portal-card:hover {
    transform: translateY(-4px);
    border-color: color-mix(in srgb, var(--brand) 60%, var(--border));
    box-shadow: 0 16px 36px -10px rgba(0, 0, 0, 0.12);
  }
  .portal-card:hover::before {
    height: 100%;
  }
  .portal-badge {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--brand);
    margin-bottom: 0.85rem;
    font-family: var(--font-mono);
  }
  .portal-card h3 {
    margin: 0 0 0.5rem 0;
    font-size: 1.25rem;
    font-family: var(--font-display, var(--font-sans));
    font-weight: 700;
    color: var(--text);
    text-transform: uppercase;
    letter-spacing: -0.01em;
  }
  .portal-card p {
    font-size: 0.9rem;
    line-height: 1.5;
    margin-bottom: 1.25rem;
  }
  .portal-cta {
    font-size: 0.85rem;
    font-weight: 700;
    font-family: var(--font-mono);
    color: var(--brand);
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    transition: transform 0.15s ease;
  }
  .portal-card:hover .portal-cta {
    transform: translateX(3px);
  }

  @media (max-width: 900px) {
    .hero-container { grid-template-columns: 1fr; gap: 2rem; }
    .portal-grid { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 600px) {
    .portal-grid { grid-template-columns: 1fr; }
  }
</style>
