---
import BaseLayout from '../layouts/BaseLayout.astro';
import LinkedInFeed from '../components/LinkedInFeed.astro';
import { profile } from '../data/profile';
import { getCollection } from 'astro:content';

const allProjects = await getCollection('projects');
const featuredProjects = allProjects
  .filter((p) => p.data.featured)
  .sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout>
  <!-- Hero Section: Cinematic, Visual, Uncluttered & Flowing -->
  <section class="hero-section" id="hero-section">
    <!-- Interactive Ambient Canvas & Glowing Aurora -->
    <canvas id="hero-canvas" class="hero-canvas" aria-hidden="true"></canvas>
    <div class="ambient-aurora" aria-hidden="true"></div>
    <div class="grid-mesh" aria-hidden="true"></div>

    <div class="container hero-container">
      <div class="hero-content reveal-on-scroll" id="hero-content">
        <!-- Top Status Pill -->
        <div class="hero-status-pill">
          <span class="pulse-dot"></span>
          <span class="status-brand">THE IET PRIZE 2026 WINNER</span>
          <span class="status-sep">/</span>
          <span class="status-sub">FIRST-CLASS HONOURS (80%)</span>
        </div>

        <!-- Mammoth Cinematic Headline -->
        <h1 class="hero-title">
          DIGITAL LOGIC <br />
          <span class="gradient-text">&amp; HARDWARE TESTBEDS.</span>
        </h1>

        <!-- Confident, Uncluttered Subtitle -->
        <p class="hero-subtitle">
          Hi, I’m <strong>Harry Rogers</strong>. I push physical electro-optical defence platforms and FPGA silicon to verified limits — engineering automated test rigs, sub-microsecond RTL telemetry, and zero-defect validation suites.
        </p>

        <!-- Horizontal Floating Telemetry Bar (Clean & Visual, Zero Clutter) -->
        <div class="telemetry-bar">
          <div class="telemetry-cell">
            <span class="telemetry-number stat-counter" data-target="91" data-suffix="%">91%</span>
            <span class="telemetry-label">Dissertation (A+)</span>
          </div>
          <div class="telemetry-divider" aria-hidden="true"></div>
          <div class="telemetry-cell">
            <span class="telemetry-number stat-counter" data-target="1" data-suffix="st">1st</span>
            <span class="telemetry-label">BEng Honours</span>
          </div>
          <div class="telemetry-divider" aria-hidden="true"></div>
          <div class="telemetry-cell">
            <span class="telemetry-number brand-accent">IET</span>
            <span class="telemetry-label">Prize Winner '26</span>
          </div>
          <div class="telemetry-divider" aria-hidden="true"></div>
          <div class="telemetry-cell">
            <span class="telemetry-number">CHESS</span>
            <span class="telemetry-label">Defence Optronics</span>
          </div>
        </div>

        <!-- Action Links -->
        <div class="hero-actions">
          <a class="btn btn-primary" href="/projects">Explore Projects →</a>
          <a class="btn ghost" href="/cv">Master CV</a>
          <a class="btn ghost" href="/terminal" title="Launch retro terminal">&gt;_ Retro CLI</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Continuous Telemetry Ticker Ribbon (Flowing Momentum) -->
  <div class="ticker-strip" aria-label="Key Distinctions Continuous Marquee">
    <div class="ticker-wrap">
      <div class="ticker-track">
        <span class="ticker-node brand">◆ VAIDAR HIL FRAMEWORK</span>
        <span class="ticker-node white">★ THE IET PRIZE 2026 WINNER</span>
        <span class="ticker-node brand">⚡ CHESS DYNAMICS DEFENCE OPTRONICS</span>
        <span class="ticker-node">◆ BAE SYSTEMS IV&amp;V AVIONICS</span>
        <span class="ticker-node brand">⚡ XILINX ARTIX-7 RTL VERIFICATION</span>
        <span class="ticker-node white">★ FIRST-CLASS HONOURS (80% ACCREDITED)</span>
        <span class="ticker-node">◆ 91% DISSERTATION DISTINCTION</span>
        <!-- Continuous loop copy -->
        <span class="ticker-node brand">◆ VAIDAR HIL FRAMEWORK</span>
        <span class="ticker-node white">★ THE IET PRIZE 2026 WINNER</span>
        <span class="ticker-node brand">⚡ CHESS DYNAMICS DEFENCE OPTRONICS</span>
        <span class="ticker-node">◆ BAE SYSTEMS IV&amp;V AVIONICS</span>
        <span class="ticker-node brand">⚡ XILINX ARTIX-7 RTL VERIFICATION</span>
        <span class="ticker-node white">★ FIRST-CLASS HONOURS (80% ACCREDITED)</span>
        <span class="ticker-node">◆ 91% DISSERTATION DISTINCTION</span>
      </div>
    </div>
  </div>

  <!-- Featured Case Studies: Cinematic Visual Showcase -->
  <section class="section showcase-section reveal-on-scroll">
    <div class="container">
      <div class="section-header">
        <div>
          <p class="eyebrow">// 01 ARCHITECTURE &amp; VERIFICATION</p>
          <h2>Featured Hardware Case Studies</h2>
        </div>
        <a class="view-all" href="/projects">Explore all {allProjects.length} projects →</a>
      </div>

      <!-- Large Visual Showcase Grid -->
      <div class="showcase-grid reveal-stagger">
        {featuredProjects.slice(0, 2).map((project) => (
          <a href={`/projects/${project.id}`} class="showcase-card spotlight-card">
            <div class="showcase-visual">
              {project.data.thumbnail && (
                <img
                  src={project.data.thumbnail}
                  alt={project.data.title}
                  loading="lazy"
                  class="showcase-img"
                />
              )}
              <div class="showcase-scrim" aria-hidden="true"></div>
              {project.data.badge && (
                <span class="showcase-badge">{project.data.badge}</span>
              )}
              <span class="showcase-status">{project.data.status}</span>
            </div>
            <div class="showcase-body">
              <div class="showcase-meta">
                <span class="showcase-year font-mono">{project.data.date.getFullYear()}</span>
                <span class="showcase-sep">/</span>
                <span class="showcase-scope font-mono">FLAGSHIP SYSTEM</span>
              </div>
              <h3 class="showcase-title">{project.data.title}</h3>
              <p class="showcase-summary">{project.data.summary}</p>
              <div class="showcase-footer">
                <ul class="showcase-tags">
                  {project.data.tags.slice(0, 3).map((tag) => (
                    <li class="tag">{tag}</li>
                  ))}
                </ul>
                <span class="showcase-cta">
                  View Case Study <span class="arrow">→</span>
                </span>
              </div>
            </div>
          </a>
        ))}
      </div>

      <!-- Quick Category Navigation Jump Pills -->
      <div class="project-quick-links">
        <a href="/projects#fpga" class="pill-link"><span class="pill-sym">//</span> FPGA &amp; RTL Verilog →</a>
        <a href="/projects#embedded" class="pill-link"><span class="pill-sym">//</span> Embedded C &amp; PIC →</a>
        <a href="/projects#hardware" class="pill-link"><span class="pill-sym">//</span> Autonomous Robotics →</a>
        <a href="/projects#dsp" class="pill-link"><span class="pill-sym">//</span> MATLAB Telemetry &amp; DSP →</a>
      </div>
    </div>
  </section>

  <!-- Deep Navigation Grid (Sub-Page Portal) -->
  <section class="section portal-section reveal-on-scroll">
    <div class="container">
      <div class="section-header">
        <div>
          <p class="eyebrow">// 02 MISSION DIRECTORY</p>
          <h2>Explore The Site</h2>
        </div>
      </div>

      <div class="portal-grid reveal-stagger">
        <a href="/experience" class="card portal-card spotlight-card">
          <div class="portal-index font-mono">01</div>
          <div class="portal-badge">CAREER TIMELINE</div>
          <h3>Work Experience</h3>
          <p class="muted">Chess Dynamics electro-optics test engineering &amp; BAE Systems 12-month flight IV&amp;V placement.</p>
          <span class="portal-cta">View career timeline <span class="arrow">→</span></span>
        </a>

        <a href="/cv" class="card portal-card spotlight-card">
          <div class="portal-index font-mono">02</div>
          <div class="portal-badge">ACCREDITED MARKS</div>
          <h3>Curriculum Vitae</h3>
          <p class="muted">First-Class Honours degree breakdown, 17 accredited module marks, and downloadable Master PDF.</p>
          <span class="portal-cta">Open Master CV <span class="arrow">→</span></span>
        </a>

        <a href="/about" class="card portal-card spotlight-card">
          <div class="portal-index font-mono">03</div>
          <div class="portal-badge">ETHOS &amp; BIO</div>
          <h3>About &amp; Journey</h3>
          <p class="muted">Academic background, IET Prize 2026 award story, and verification engineering philosophy.</p>
          <span class="portal-cta">Read biography <span class="arrow">→</span></span>
        </a>

        <a href="/contact" class="card portal-card spotlight-card">
          <div class="portal-index font-mono">04</div>
          <div class="portal-badge">DIRECT COMMS</div>
          <h3>Get in Touch</h3>
          <p class="muted">Direct verified contact form, direct secure email address, and active messaging channels.</p>
          <span class="portal-cta">Send message <span class="arrow">→</span></span>
        </a>
      </div>
    </div>
  </section>

  <!-- LinkedIn Updates & Network (Clean Dispatch Mode) -->
  <section class="section network-section reveal-on-scroll">
    <div class="container">
      <div class="section-header">
        <div>
          <p class="eyebrow">// 03 DISPATCH WIRE</p>
          <h2>Field Notes &amp; Updates</h2>
        </div>
        <a class="view-all" href={profile.links.linkedin} target="_blank" rel="noopener noreferrer">
          LinkedIn Profile ↗
        </a>
      </div>

      <div class="reveal-stagger">
        <LinkedInFeed compact={true} />
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // ---------- Hero Ambient Particle & Telemetry Wave Canvas ----------
  (() => {
    const canvas = document.getElementById('hero-canvas') as HTMLCanvasElement | null;
    const heroSection = document.getElementById('hero-section');
    const heroContent = document.getElementById('hero-content');
    if (!canvas || !heroSection) return;

    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    let width = 0;
    let height = 0;
    let animationFrameId: number;
    let isVisible = true;
    let mouse = { x: -1000, y: -1000, radius: 140 };

    interface Node {
      x: number;
      y: number;
      vx: number;
      vy: number;
      radius: number;
      alpha: number;
    }

    const nodes: Node[] = [];
    const nodeCount = 38;

    function resize() {
      if (!canvas || !heroSection) return;
      const rect = heroSection.getBoundingClientRect();
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      width = rect.width;
      height = rect.height;
      canvas.width = width * dpr;
      canvas.height = height * dpr;
      ctx.resetTransform();
      ctx.scale(dpr, dpr);
      initNodes();
    }

    function initNodes() {
      nodes.length = 0;
      for (let i = 0; i < nodeCount; i++) {
        const x = Math.random() * width;
        const y = Math.random() * height;
        nodes.push({
          x,
          y,
          vx: (Math.random() - 0.5) * 0.45,
          vy: (Math.random() - 0.5) * 0.45,
          radius: Math.random() * 1.5 + 1,
          alpha: Math.random() * 0.45 + 0.25,
        });
      }
    }

    function animate() {
      if (!isVisible) return;
      ctx.clearRect(0, 0, width, height);

      const isDark = document.documentElement.dataset.theme !== 'light';
      const nodeColor = isDark ? '56, 189, 248' : '30, 108, 147';

      // Update and render nodes
      for (let i = 0; i < nodes.length; i++) {
        const n = nodes[i];
        n.x += n.vx;
        n.y += n.vy;

        if (n.x < 0 || n.x > width) n.vx *= -1;
        if (n.y < 0 || n.y > height) n.vy *= -1;

        // Mouse repelling force
        const dx = mouse.x - n.x;
        const dy = mouse.y - n.y;
        const dist = Math.sqrt(dx * dx + dy * dy);
        if (dist < mouse.radius) {
          const force = (mouse.radius - dist) / mouse.radius;
          n.x -= (dx / dist) * force * 1.8;
          n.y -= (dy / dist) * force * 1.8;
        }

        // Draw node
        ctx.beginPath();
        ctx.arc(n.x, n.y, n.radius, 0, Math.PI * 2);
        ctx.fillStyle = `rgba(${nodeColor}, ${n.alpha})`;
        ctx.fill();

        // Connect nearby nodes
        for (let j = i + 1; j < nodes.length; j++) {
          const n2 = nodes[j];
          const dist2 = Math.hypot(n.x - n2.x, n.y - n2.y);
          if (dist2 < 115) {
            const lineAlpha = (1 - dist2 / 115) * 0.18;
            ctx.beginPath();
            ctx.moveTo(n.x, n.y);
            ctx.lineTo(n2.x, n2.y);
            ctx.strokeStyle = `rgba(${nodeColor}, ${lineAlpha})`;
            ctx.lineWidth = 0.8;
            ctx.stroke();
          }
        }
      }

      animationFrameId = requestAnimationFrame(animate);
    }

    // Mouse tracking
    heroSection.addEventListener('mousemove', (e) => {
      const rect = heroSection.getBoundingClientRect();
      mouse.x = e.clientX - rect.left;
      mouse.y = e.clientY - rect.top;
    });

    heroSection.addEventListener('mouseleave', () => {
      mouse.x = -1000;
      mouse.y = -1000;
    });

    // Pause canvas when out of view
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          isVisible = entry.isIntersecting;
          if (isVisible) {
            cancelAnimationFrame(animationFrameId);
            animate();
          } else {
            cancelAnimationFrame(animationFrameId);
          }
        });
      },
      { threshold: 0 }
    );
    observer.observe(heroSection);

    // Scroll-linked fade out of hero
    window.addEventListener('scroll', () => {
      if (!heroSection) return;
      const scrollY = window.scrollY;
      const heroHeight = heroSection.offsetHeight;
      if (scrollY < heroHeight) {
        const factor = Math.max(0, 1 - scrollY / (heroHeight * 0.85));
        canvas.style.opacity = String(factor);
        if (heroContent) {
          heroContent.style.opacity = String(Math.max(0.2, factor));
          heroContent.style.transform = `translateY(${scrollY * 0.12}px)`;
        }
      }
    }, { passive: true });

    window.addEventListener('resize', resize);
    resize();
    animate();
  })();

  // ---------- Animated Numbers Counter for Telemetry Bar ----------
  (() => {
    const counters = document.querySelectorAll<HTMLElement>('.stat-counter');
    if (!counters.length) return;

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const el = entry.target as HTMLElement;
            const target = parseInt(el.dataset.target || '0', 10);
            const suffix = el.dataset.suffix || '';
            const duration = 1200;
            const startTime = performance.now();

            function updateCount(currentTime: number) {
              const elapsed = currentTime - startTime;
              const progress = Math.min(elapsed / duration, 1);
              const ease = 1 - Math.pow(1 - progress, 3);
              const currentVal = Math.floor(ease * target);
              el.textContent = `${currentVal}${suffix}`;

              if (progress < 1) {
                requestAnimationFrame(updateCount);
              } else {
                el.textContent = `${target}${suffix}`;
              }
            }

            requestAnimationFrame(updateCount);
            observer.unobserve(el);
          }
        });
      },
      { threshold: 0.2 }
    );

    counters.forEach((c) => observer.observe(c));
  })();

  // ---------- Interactive Spotlight Effect on Cards ----------
  (() => {
    const cards = document.querySelectorAll<HTMLElement>('.spotlight-card');
    cards.forEach((card) => {
      card.addEventListener('mousemove', (e) => {
        const rect = card.getBoundingClientRect();
        const x = e.clientX - rect.left;
        const y = e.clientY - rect.top;
        card.style.setProperty('--mouse-x', `${x}px`);
        card.style.setProperty('--mouse-y', `${y}px`);
      });
    });
  })();
</script>

<style>
  /* ---------- Hero Section (Cinematic & Spacious) ---------- */
  .hero-section {
    position: relative;
    padding-top: 5.5rem;
    padding-bottom: 5rem;
    overflow: hidden;
    min-height: 82vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
  }

  .hero-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 0;
    transition: opacity 0.2s ease-out;
  }

  /* Grid overlay for McLaren/FPGA telemetry feel */
  .grid-mesh {
    position: absolute;
    inset: 0;
    background-size: 36px 36px;
    background-image: 
      linear-gradient(to right, color-mix(in srgb, var(--border) 18%, transparent) 1px, transparent 1px),
      linear-gradient(to bottom, color-mix(in srgb, var(--border) 18%, transparent) 1px, transparent 1px);
    -webkit-mask-image: radial-gradient(circle at 50% 40%, black 25%, transparent 75%);
    mask-image: radial-gradient(circle at 50% 40%, black 25%, transparent 75%);
    pointer-events: none;
    z-index: 0;
  }

  /* Ambient radial background glow */
  .ambient-aurora {
    position: absolute;
    top: 5%;
    left: 50%;
    transform: translateX(-50%);
    width: min(900px, 94vw);
    height: 520px;
    background: radial-gradient(circle, color-mix(in srgb, var(--brand) 16%, transparent) 0%, color-mix(in srgb, var(--accent) 7%, transparent) 45%, transparent 75%);
    pointer-events: none;
    filter: blur(95px);
    z-index: 0;
  }

  .hero-container {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: 58rem;
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    transition: transform 0.1s ease-out, opacity 0.1s ease-out;
    will-change: transform, opacity;
  }

  /* Status Badge */
  .hero-status-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.45rem 1.1rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--surface) 80%, transparent);
    backdrop-filter: blur(12px);
    border: 1px solid color-mix(in srgb, var(--brand) 30%, var(--border));
    margin-bottom: 2rem;
    font-family: var(--font-mono);
    font-size: 0.76rem;
    letter-spacing: 0.08em;
  }
  .status-brand {
    font-weight: 700;
    color: var(--brand);
  }
  .status-sep {
    color: var(--muted);
    opacity: 0.4;
  }
  .status-sub {
    color: var(--text);
    font-weight: 600;
  }

  .pulse-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #10b981;
    box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.25);
  }

  /* Title & Subtitle */
  .hero-title {
    font-family: var(--font-display, var(--font-sans));
    font-size: clamp(2.8rem, 6vw, 4.8rem);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.03em;
    text-transform: uppercase;
    margin-bottom: 1.6rem;
  }

  .gradient-text {
    background: linear-gradient(135deg, var(--brand) 0%, #38bdf8 50%, #818cf8 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hero-subtitle {
    font-size: clamp(1.05rem, 2vw, 1.22rem);
    color: var(--muted);
    line-height: 1.65;
    max-width: 42rem;
    margin-bottom: 2.25rem;
  }

  /* Horizontal Floating Telemetry Bar (Zero Clutter) */
  .telemetry-bar {
    display: inline-flex;
    align-items: center;
    background: color-mix(in srgb, var(--surface) 85%, transparent);
    backdrop-filter: blur(16px);
    border: 1px solid color-mix(in srgb, var(--brand) 25%, var(--border));
    border-radius: 14px;
    padding: 0.85rem 1.85rem;
    box-shadow: var(--shadow);
    gap: 1.75rem;
    margin-bottom: 2.5rem;
  }
  .telemetry-cell {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .telemetry-number {
    font-family: var(--font-mono);
    font-size: 1.75rem;
    font-weight: 800;
    line-height: 1.1;
    color: var(--text);
  }
  .telemetry-label {
    font-size: 0.68rem;
    text-transform: uppercase;
    font-weight: 600;
    letter-spacing: 0.06em;
    color: var(--muted);
    margin-top: 0.2rem;
  }
  .telemetry-divider {
    width: 1px;
    height: 32px;
    background: var(--border);
    opacity: 0.6;
  }
  .brand-accent {
    color: var(--brand);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.85rem;
  }
  .hero-actions .btn {
    padding: 0.75rem 1.5rem;
    font-size: 0.95rem;
  }

  /* ---------- Section Spacing & Headers ---------- */
  .section.showcase-section,
  .section.portal-section,
  .section.network-section {
    padding: 4rem 0;
  }

  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 2.25rem;
  }
  .view-all {
    color: var(--brand);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.92rem;
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    transition: transform 0.15s ease, color 0.15s ease;
  }
  .view-all:hover {
    color: var(--brand-strong);
    transform: translateX(3px);
  }

  /* ---------- Visual Showcase Grid (Flagship Projects) ---------- */
  .showcase-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
  }

  .showcase-card {
    display: flex;
    flex-direction: column;
    border-radius: 14px;
    overflow: hidden;
    background: var(--surface);
    border: 1px solid var(--border);
    text-decoration: none;
    color: var(--text);
    position: relative;
    transition: transform 0.28s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.28s ease, box-shadow 0.28s ease;
  }
  .showcase-card:hover {
    transform: translateY(-6px);
    border-color: color-mix(in srgb, var(--brand) 70%, var(--border));
    box-shadow: 0 20px 45px -15px rgba(0, 0, 0, 0.18);
  }

  .showcase-visual {
    position: relative;
    width: 100%;
    height: 270px;
    background: var(--surface-2);
    overflow: hidden;
  }
  .showcase-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .showcase-card:hover .showcase-img {
    transform: scale(1.05);
  }
  .showcase-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, color-mix(in srgb, var(--surface) 95%, transparent) 0%, transparent 60%);
    pointer-events: none;
  }

  .showcase-badge {
    position: absolute;
    top: 1rem;
    right: 1rem;
    background: color-mix(in srgb, var(--surface) 90%, transparent);
    backdrop-filter: blur(10px);
    color: var(--brand);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    padding: 0.35rem 0.8rem;
    border-radius: 6px;
    border: 1px solid color-mix(in srgb, var(--brand) 30%, var(--border));
