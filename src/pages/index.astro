    <div class="container hero-container">
      <div class="hero-content reveal-on-scroll" id="hero-content">
        <!-- Human Status Pill -->
        <div class="hero-status-pill">
          <span class="pulse-dot"></span>
          <span class="status-brand">Chess Dynamics</span>
          <span class="status-sep">•</span>
          <span class="status-sub">Hardware Test Engineer</span>
        </div>

        <!-- Organic Headline -->
        <h1 class="hero-title">
          Hardware test engineer, <br />
          <span class="gradient-text">defence robotics &amp; FPGA logic.</span>
        </h1>

        <!-- Genuine, Grounded Subtitle: Explicitly Sussex, UK -->
        <p class="hero-subtitle">
          Hi, I’m <strong>Harry Rogers</strong>, a <strong>Hardware Test Engineer</strong> based in <strong>Sussex, UK</strong>. I lead test operations for Land Systems electro-optics at Chess Dynamics and develop automated hardware-in-the-loop validation tools for FPGAs.
        </p>

        <!-- Availability / Collaboration Callout -->
        <div class="hero-collaboration-note">
          <span class="pulse-dot-green"></span>
          <span>Open to technical discussions on FPGA testbenches, automated verification &amp; defence robotics</span>
        </div>

        <!-- Understated, Clean Key Facts Bar -->
        <div class="facts-bar">
          <div class="fact-item">
            <span class="fact-number stat-counter" data-target="80" data-suffix="%">80%</span>
            <span class="fact-label">First Class BEng (Hons)</span>
          </div>
          <div class="fact-sep" aria-hidden="true"></div>
          <div class="fact-item">
            <span class="fact-number stat-counter" data-target="91" data-suffix="%">91%</span>
            <span class="fact-label">First Class Dissertation</span>
          </div>
          <div class="fact-sep" aria-hidden="true"></div>
          <div class="fact-item">
            <span class="fact-number brand-accent">IET</span>
            <span class="fact-label">Prize Winner 2026</span>
          </div>
          <div class="fact-sep" aria-hidden="true"></div>
          <div class="fact-item">
            <span class="fact-number fact-text">Land System</span>
            <span class="fact-label">Hardware</span>
          </div>
        </div>

        <!-- Action Buttons -->
        <div class="hero-actions">
          <a class="btn btn-primary" href="#defence-robotics">Explore Defence Robotics ↓</a>
          <a class="btn ghost" href="#featured-project">VAIDAR FPGA Testbed</a>
          <a class="btn ghost" href="/contact">Get in Touch</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Defence Robotics & Hawkeye Optronics Spotlight (Combat Vehicle Platform) -->
  <section class="section defence-section reveal-on-scroll" id="defence-robotics">
    <div class="container">
      <div class="section-header">
        <div>
          <p class="eyebrow">Defence Engineering</p>
          <h2>Robotics &amp; Electro-Optics at Chess</h2>
        </div>
        <a class="view-all" href="/experience">View career timeline →</a>
      </div>

      <div class="defence-card spotlight-card">
        <div class="defence-media defence-logo-stage">
          <a
            href="https://www.chess-dynamics.com/"
            target="_blank"
            rel="noopener noreferrer"
            class="logo-display-card"
            title="Visit official Chess Dynamics website (chess-dynamics.com)"
            aria-label="Visit Chess Dynamics official corporate website"
          >
            <img
              src="/images/defence/chess-dynamics-logo.png"
              alt="Chess Dynamics — A Cohort plc Company logo"
              class="defence-logo-img"
              width="250"
              height="119"
              loading="lazy"
            />
            <span class="logo-link-hint font-mono">chess-dynamics.com ↗</span>
          </a>
          <span class="defence-badge">Chess Dynamics • West Sussex</span>

          <a
            href="https://www.chess-dynamics.com/products/hawkeye/"
            target="_blank"
            rel="noopener noreferrer"
            class="hawkeye-media-link"
            title="View official Hawkeye electro-optical directors and vehicle imagery on Chess Dynamics"
          >
            <span>Hawkeye Vehicle Photos &amp; Specs ↗</span>
          </a>
        </div>

        <div class="defence-content">
          <div class="defence-meta">
            <span class="meta-tag">Land Systems</span>
            <span class="meta-sep">•</span>
            <span class="meta-scope">Test Team Lead</span>
          </div>

          <h3 class="defence-title">
            Land Systems Testing &amp; Electro-Optic Integration
          </h3>

          <p class="defence-description">
            I am the test lead for the Land Systems division at Chess Dynamics in West Sussex. I coordinate Factory Acceptance Testing (FAT), board-level fault diagnostics, and environmental qualification on the <strong>Hawkeye</strong> family of electro-optical tracking directors.
          </p>

          <p class="defence-description">
            These precision-stabilised camera and laser platforms integrate daylight HD optics, cooled thermal imagers, and eye-safe laser rangefinders onto defence vehicle platforms for international allied programmes.
          </p>

          <div class="defence-update-callout">
            <span class="update-label font-mono">2026 Role Scope &amp; Focus</span>
            <p>
              Serving as primary Test Point of Contact for the Land Integrated Portfolio Team (IPT). Responsibilities encompass coordinating Factory Acceptance Testing (FAT), multi-channel serial telemetry verification (RS-422, CAN, Ethernet), optical boresighting, and environmental qualification. All technical descriptions cite public Chess Dynamics product literature.
            </p>
          </div>

          <ul class="defence-tags">
            <li class="tag">Land IPT Test Coordination</li>
            <li class="tag">Factory Acceptance Testing (FAT)</li>
            <li class="tag">Optical Boresighting</li>
            <li class="tag">RS-422 / CAN / Ethernet Telemetry</li>
            <li class="tag">Environmental Qualification (ESS)</li>
            <li class="tag">Defect Diagnostics &amp; SOPs</li>
          </ul>

          <div class="defence-actions">
            <a href="/experience#chess-dynamics" class="btn btn-primary">
              Explore Work Experience Timeline →
            </a>
            <a
              href="https://www.chess-dynamics.com/products/hawkeye/"
              target="_blank"
              rel="noopener noreferrer"
              class="btn ghost"
              title="View official Hawkeye electro-optical directors and vehicle imagery on Chess Dynamics"
            >
              Hawkeye Gallery &amp; Official Specs ↗
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Featured Project (Strictly ONE Showstopper Academic Project: VAIDAR) -->
  <section class="section project-section reveal-on-scroll" id="featured-project">
    <div class="container">
      <div class="section-header">
        <div>
          <p class="eyebrow">First Class Honours</p>
          <h2>Featured FPGA Case Study</h2>
        </div>
        <a class="view-all" href="/projects">Browse all {allProjects.length} projects →</a>
      </div>

      <!-- Single Hero Case Study Card -->
      <article class="hero-project-card spotlight-card">
        <div class="project-media">
          {vaidarProject.data.thumbnail && (
            <img
              src={vaidarProject.data.thumbnail}
              alt={vaidarProject.data.title}
              loading="lazy"
              class="project-img"
            />
          )}
          <div class="media-overlay" aria-hidden="true"></div>
          {vaidarProject.data.badge && (
            <span class="project-badge">{vaidarProject.data.badge}</span>
          )}
        </div>

        <div class="project-content">
          <div class="project-meta">
            <span class="meta-tag">{vaidarProject.data.status}</span>
            <span class="meta-sep">•</span>
            <span class="meta-date">{vaidarProject.data.date.getFullYear()}</span>
            <span class="meta-sep">•</span>
            <span class="meta-uni">University of Brighton BEng</span>
          </div>

          <h3 class="project-title">
            <a href={`/projects/${vaidarProject.id}`}>{vaidarProject.data.title}</a>
          </h3>

          <p class="project-description">
            For my final year dissertation, I built <strong>VAIDAR</strong> — an automated Hardware-in-the-Loop testbench for AMD Xilinx Artix-7 FPGAs. It streams Python stimulus vectors across a 921,600 baud UART bridge directly into physical silicon, validating outputs against golden models at <strong>968 tests per second</strong> to catch hardware bugs that pure software simulation misses.
          </p>

          <ul class="project-tags">
            {vaidarProject.data.tags.map((tag) => (
              <li class="tag">{tag}</li>
            ))}
          </ul>

          <div class="project-actions">
            <a href={`/projects/${vaidarProject.id}`} class="btn btn-primary">
              Read the Full Case Study →
            </a>
            <a href="https://github.com/HarryRogers073/vaidar" target="_blank" rel="noopener noreferrer" class="btn ghost">
              View Source on GitHub ↗
            </a>
            <a href="/projects" class="btn ghost">
              All Projects ({allProjects.length})
            </a>
          </div>
        </div>
      </article>
    </div>
  </section>

  <!-- Deep Navigation Grid (Organic Site Portal) -->
  <section class="section nav-section reveal-on-scroll">
    <div class="container">
      <div class="section-header">
        <div>
          <p class="eyebrow">Explore</p>
          <h2>Where would you like to go?</h2>
        </div>
      </div>

      <div class="nav-grid reveal-stagger">
        <a href="/experience" class="card nav-card spotlight-card">
          <span class="nav-num font-mono">01</span>
          <div class="nav-badge">CAREER</div>
          <h3>Work Experience</h3>
          <p class="muted">
            My work testing defence optronics at Chess Dynamics, and a 12-month placement at BAE Systems working on flight avionics.
          </p>
          <span class="nav-cta">View career timeline <span class="arrow">→</span></span>
        </a>

        <a href="/cv" class="card nav-card spotlight-card">
          <span class="nav-num font-mono">02</span>
          <div class="nav-badge">CREDENTIALS</div>
          <h3>Curriculum Vitae</h3>
          <p class="muted">
            First Class 80% degree breakdown, 17 module marks across all three years, and a downloadable PDF.
          </p>
          <span class="nav-cta">Open full CV <span class="arrow">→</span></span>
        </a>

        <a href="/about" class="card nav-card spotlight-card">
          <span class="nav-num font-mono">03</span>
          <div class="nav-badge">BIOGRAPHY</div>
          <h3>About Me</h3>
          <p class="muted">
            My background in electronics, how I got into FPGA design, and the story behind the 2026 IET Prize.
          </p>
          <span class="nav-cta">Read background <span class="arrow">→</span></span>
        </a>

        <a href="/contact" class="card nav-card spotlight-card">
          <span class="nav-num font-mono">04</span>
          <div class="nav-badge">GET IN TOUCH</div>
          <h3>Contact</h3>
          <p class="muted">
            Send me a direct message, find my email address, or connect on LinkedIn.
          </p>
          <span class="nav-cta">Send message <span class="arrow">→</span></span>
        </a>
      </div>
    </div>
  </section>

  <!-- LinkedIn Updates & Network (Clean Dispatch Mode) -->
  <section class="section updates-section reveal-on-scroll">
    <div class="container">
      <div class="section-header">
        <div>
          <p class="eyebrow">Professional Highlights</p>
          <h2>Recent Milestones &amp; Updates</h2>
        </div>
        <a class="view-all" href={profile.links.linkedin} target="_blank" rel="noopener noreferrer">
          Connect on LinkedIn ↗
        </a>
      </div>

      <div class="reveal-stagger">
        <LinkedInFeed compact={true} />
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // ---------- Continuous Sensual Flow & Floating Lines Canvas ----------
  (() => {
    const canvas = document.getElementById('bg-flow-canvas') as HTMLCanvasElement | null;
    if (!canvas) return;

    const rawCtx = canvas.getContext('2d');
    if (!rawCtx) return;
    const ctx: CanvasRenderingContext2D = rawCtx;

    let width = 0;
    let height = 0;
    let animationFrameId: number;
    let isVisible = true;
    let scrollY = window.scrollY;
    let targetScrollY = window.scrollY;

    const mouse = {
      x: -1000,
      y: -1000,
      targetX: -1000,
      targetY: -1000,
      radius: 190,
    };

    // Node particle constellation
    interface Node {
      x: number;
      y: number;
      vx: number;
      vy: number;
      radius: number;
      alpha: number;
      phase: number;
    }

    const nodes: Node[] = [];
    const nodeCount = 42;

    function resize() {
      if (!canvas) return;
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      width = window.innerWidth;
      height = window.innerHeight;
      canvas.width = width * dpr;
      canvas.height = height * dpr;
      canvas.style.width = `${width}px`;
      canvas.style.height = `${height}px`;
      ctx.resetTransform();
      ctx.scale(dpr, dpr);
      initNodes();
    }

    function initNodes() {
      nodes.length = 0;
      for (let i = 0; i < nodeCount; i++) {
        const x = Math.random() * width;
        const y = Math.random() * height;
        nodes.push({
          x,
          y,
          vx: (Math.random() - 0.5) * 0.32,
          vy: (Math.random() - 0.5) * 0.32,
          radius: Math.random() * 1.5 + 0.8,
          alpha: Math.random() * 0.38 + 0.18,
          phase: Math.random() * Math.PI * 2,
        });
      }
    }

    let time = 0;

    function drawSensualWave(
      yOffsetRatio: number,
      amplitude: number,
      wavelength: number,
      speed: number,
      colorStart: string,
      colorEnd: string,
      alpha: number
    ) {
      if (!ctx) return;
      ctx.save();
      const baseY = height * yOffsetRatio + Math.sin(time * 0.0006 + yOffsetRatio * 4) * 25;
      
      const grad = ctx.createLinearGradient(0, 0, width, 0);
      grad.addColorStop(0, colorStart);
      grad.addColorStop(0.5, colorEnd);
      grad.addColorStop(1, colorStart);

      ctx.beginPath();
      const step = 20;
      let started = false;

      for (let x = -20; x <= width + 20; x += step) {
        // Multi-harmonic sensual undulation
        const wave1 = Math.sin(x * wavelength + time * speed + scrollY * 0.001) * amplitude;
        const wave2 = Math.cos(x * wavelength * 0.5 - time * speed * 0.7) * (amplitude * 0.4);
        
        // Gentle cursor deflection
        const dx = mouse.x - x;
        const dy = mouse.y - (baseY + wave1 + wave2);
        const dist = Math.hypot(dx, dy);
        let mouseDeflection = 0;
        if (dist < mouse.radius) {
          const factor = (mouse.radius - dist) / mouse.radius;
          mouseDeflection = Math.sin(factor * Math.PI) * 26 * (dy < 0 ? -1 : 1);
        }

        const y = baseY + wave1 + wave2 + mouseDeflection;

        if (!started) {
          ctx.moveTo(x, y);
          started = true;
        } else {
          ctx.lineTo(x, y);
        }
      }

      ctx.strokeStyle = grad;
      ctx.lineWidth = 1;
      ctx.globalAlpha = alpha;
      ctx.stroke();
      ctx.restore();
    }

    function animate() {
      if (!isVisible) return;
      time++;

      // Smooth scroll interpolation
      scrollY += (targetScrollY - scrollY) * 0.08;
      // Smooth mouse interpolation
      mouse.x += (mouse.targetX - mouse.x) * 0.08;
      mouse.y += (mouse.targetY - mouse.y) * 0.08;

      ctx.clearRect(0, 0, width, height);

      const isDark = document.documentElement.dataset.theme !== 'light';
      const nodeColor = isDark ? '56, 189, 248' : '30, 108, 147';

      // 1. Draw sensual undulating wave ribbons
      if (isDark) {
        drawSensualWave(0.24, 44, 0.0022, 0.0009, 'rgba(56, 189, 248, 0)', 'rgba(56, 189, 248, 0.28)', 0.85);
        drawSensualWave(0.50, 52, 0.0018, 0.0007, 'rgba(129, 140, 248, 0)', 'rgba(129, 140, 248, 0.22)', 0.75);
        drawSensualWave(0.76, 46, 0.0020, 0.0008, 'rgba(16, 185, 129, 0)', 'rgba(56, 189, 248, 0.24)', 0.8);
      } else {
        drawSensualWave(0.26, 36, 0.0020, 0.0008, 'rgba(30, 108, 147, 0)', 'rgba(30, 108, 147, 0.2)', 0.7);
        drawSensualWave(0.52, 44, 0.0017, 0.0006, 'rgba(14, 165, 164, 0)', 'rgba(14, 165, 164, 0.16)', 0.65);
        drawSensualWave(0.78, 38, 0.0022, 0.0008, 'rgba(30, 108, 147, 0)', 'rgba(30, 108, 147, 0.18)', 0.7);
      }

      // 2. Draw floating nodes and sensual interconnecting lines
      for (let i = 0; i < nodes.length; i++) {
        const n = nodes[i];
        n.x += n.vx;
        n.y += n.vy;

        // Soft harmonic breathing
        n.phase += 0.015;
        const currentAlpha = n.alpha + Math.sin(n.phase) * 0.1;

        if (n.x < 0) n.x = width;
        if (n.x > width) n.x = 0;
        if (n.y < 0) n.y = height;
        if (n.y > height) n.y = 0;

        // Gentle cursor influence
        const dx = mouse.x - n.x;
        const dy = mouse.y - n.y;
        const dist = Math.hypot(dx, dy);
        if (dist < mouse.radius) {
          const force = (mouse.radius - dist) / mouse.radius;
          n.x -= (dx / dist) * force * 1.4;
          n.y -= (dy / dist) * force * 1.4;
        }

        // Draw particle
        ctx.beginPath();
        ctx.arc(n.x, n.y, n.radius, 0, Math.PI * 2);
        ctx.fillStyle = `rgba(${nodeColor}, ${Math.max(0.1, currentAlpha)})`;
        ctx.fill();

        // Connect nearby nodes with delicate sensual strands
        for (let j = i + 1; j < nodes.length; j++) {
          const n2 = nodes[j];
          const dist2 = Math.hypot(n.x - n2.x, n.y - n2.y);
          if (dist2 < 125) {
            const lineAlpha = Math.pow(1 - dist2 / 125, 1.5) * 0.18;
            ctx.beginPath();
            ctx.moveTo(n.x, n.y);
            ctx.lineTo(n2.x, n2.y);
            ctx.strokeStyle = `rgba(${nodeColor}, ${lineAlpha})`;
            ctx.lineWidth = 0.85;
            ctx.stroke();
          }
        }
      }

      animationFrameId = requestAnimationFrame(animate);
    }

    window.addEventListener('mousemove', (e) => {
      mouse.targetX = e.clientX;
      mouse.targetY = e.clientY;
    }, { passive: true });

    window.addEventListener('mouseleave', () => {
      mouse.targetX = -1000;
      mouse.targetY = -1000;
    });

    window.addEventListener('scroll', () => {
      targetScrollY = window.scrollY;
    }, { passive: true });

    document.addEventListener('visibilitychange', () => {
      isVisible = !document.hidden;
      if (isVisible) {
        cancelAnimationFrame(animationFrameId);
        animate();
      } else {
        cancelAnimationFrame(animationFrameId);
      }
    });

    window.addEventListener('resize', resize);
    resize();
    animate();
  })();

  // ---------- Number Counter for Facts Bar ----------
  (() => {
    const counters = document.querySelectorAll<HTMLElement>('.stat-counter');
    if (!counters.length) return;

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const el = entry.target as HTMLElement;
            const target = parseInt(el.dataset.target || '0', 10);
            const suffix = el.dataset.suffix || '';
            const duration = 1100;
            const startTime = performance.now();

            function updateCount(currentTime: number) {
              const elapsed = currentTime - startTime;
              const progress = Math.min(elapsed / duration, 1);
              const ease = 1 - Math.pow(1 - progress, 3);
              const currentVal = Math.floor(ease * target);
              el.textContent = `${currentVal}${suffix}`;

              if (progress < 1) {
                requestAnimationFrame(updateCount);
              } else {
                el.textContent = `${target}${suffix}`;
              }
            }

            requestAnimationFrame(updateCount);
            observer.unobserve(el);
          }
        });
      },
      { threshold: 0.2 }
    );

    counters.forEach((c) => observer.observe(c));
  })();

  // ---------- Spotlight Card Hover Effect ----------
  (() => {
    const cards = document.querySelectorAll<HTMLElement>('.spotlight-card');
    cards.forEach((card) => {
      card.addEventListener('mousemove', (e) => {
        const rect = card.getBoundingClientRect();
        const x = e.clientX - rect.left;
        const y = e.clientY - rect.top;
        card.style.setProperty('--mouse-x', `${x}px`);
        card.style.setProperty('--mouse-y', `${y}px`);
      });
    });
  })();
</script>

<style>
  /* ---------- Full-Page Fixed Sensual Canvas & Lighting ---------- */
  .bg-flow-canvas {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    pointer-events: none;
    z-index: 0;
  }

  /* Sensual Multi-Point Ambient Glow */
  .sensual-ambient-glow {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    background: 
      radial-gradient(circle at 18% 22%, color-mix(in srgb, var(--brand) 12%, transparent) 0%, transparent 45%),
      radial-gradient(circle at 82% 65%, color-mix(in srgb, #818cf8 9%, transparent) 0%, transparent 48%),
      radial-gradient(circle at 50% 92%, color-mix(in srgb, var(--accent) 7%, transparent) 0%, transparent 45%);
    filter: blur(100px);
  }

  /* ---------- Hero Section (Organic, Human, Spacious) ---------- */
  .hero-section {
    position: relative;
    padding-top: 5rem;
    padding-bottom: 4.5rem;
    min-height: 78vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    z-index: 1;
  }

  .hero-container {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: 54rem;
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  /* Human Status Pill */
  .hero-status-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.4rem 1.05rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--surface) 80%, transparent);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border: 1px solid var(--border);
    margin-bottom: 1.8rem;
    font-size: 0.82rem;
    font-weight: 500;
  }
  .status-brand {
    font-weight: 700;
    color: var(--brand);
  }
  .status-sep {
    color: var(--muted);
    opacity: 0.5;
  }
  .status-sub {
    color: var(--text);
  }

  .pulse-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #10b981;
    box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.22);
  }

  /* Headline */
  .hero-title {
    font-family: var(--font-display, var(--font-sans));
    font-size: clamp(2.4rem, 5.2vw, 4.2rem);
    font-weight: 800;
    line-height: 1.08;
    letter-spacing: -0.025em;
    margin-bottom: 1.5rem;
  }

  .gradient-text {
    background: linear-gradient(135deg, var(--brand) 0%, #38bdf8 55%, #818cf8 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
