---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import LinkedInFeed from '../components/LinkedInFeed.astro';
import { profile } from '../data/profile';
import { getCollection } from 'astro:content';

const allProjects = await getCollection('projects');
const featuredProjects = allProjects
  .filter((p) => p.data.featured)
  .sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout>
  <!-- Hero Section (Lando Norris / Motorsport Engineering Inspired) -->
  <section class="section hero-section">
    <div class="container hero-container">
      <div class="hero-content">
        <div class="telemetry-pill-row">
          <div class="telemetry-pill">
            <span class="pulse-dot"></span>
            <span class="telemetry-pill-label">STATUS:</span>
            <span class="telemetry-pill-val">ACTIVE TEST RUNNER</span>
          </div>
          <div class="telemetry-pill secondary">
            <span class="telemetry-pill-label">SYSTEM:</span>
            <span class="telemetry-pill-val">CHESS DYNAMICS</span>
          </div>
        </div>

        <h1 class="hero-title">
          HIGH VELOCITY <br />
          <span class="gradient-text">HARDWARE TESTING</span>
        </h1>
        <p class="hero-subtitle">
          Hi, I’m <strong>Harry Rogers</strong>. I push electro-optical defence platforms and FPGA silicon to their physical limits — engineering automated test rigs, sub-microsecond RTL telemetry, and zero-defect verification suites.
        </p>
        <div class="actions">
          <a class="btn" href="/projects">Explore Projects →</a>
          <a class="btn ghost" href="/cv">View Master CV</a>
          <a class="btn ghost" href="/terminal" title="Launch retro terminal">&gt;_ Retro CLI</a>
        </div>
      </div>

      <div class="hero-badge-card card">
        <div class="badge-header">
          <span class="status-title">SILICON TELEMETRY</span>
          <span class="channel-badge">CH-01</span>
        </div>
        <ul class="badge-stats">
          <li>
            <strong class="stat-number">91%</strong>
            <span class="stat-label">Dissertation</span>
          </li>
          <li>
            <strong class="stat-number">1st</strong>
            <span class="stat-label">BEng Honours</span>
          </li>
          <li>
            <strong class="stat-number accent-num">IET</strong>
            <span class="stat-label">Prize Winner '26</span>
          </li>
        </ul>
        <div class="telemetry-sim-box">
          <div class="telemetry-sim-header">
            <span>BENCH STATUS</span>
            <span class="rate-indicator">100.00 MHz</span>
          </div>
          <div class="progress-bar-bg">
            <div class="progress-bar-fill"></div>
          </div>
          <div class="telemetry-msg">
            <span class="live-dot"></span>
            <span id="telemetry-msg-text">VAIDAR: Stimulus vector verification nominal</span>
          </div>
        </div>
        <div class="tech-stack-row">
          <span class="tag">Xilinx Vivado</span>
          <span class="tag">Verilog HDL</span>
          <span class="tag">Python HIL</span>
          <span class="tag">MATLAB</span>
          <span class="tag">Electro-Optics</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Continuous Telemetry Ticker Marquee -->
  <div class="ticker-banner">
    <div class="ticker-track">
      <div class="ticker-content">
        <span class="ticker-item highlight">◆ VAIDAR HIL FRAMEWORK</span>
        <span class="ticker-item">★ THE IET PRIZE 2026 WINNER</span>
        <span class="ticker-item brand">⚡ CHESS DYNAMICS DEFENCE OPTRONICS</span>
        <span class="ticker-item">◆ BAE SYSTEMS IV&amp;V AVIONICS</span>
        <span class="ticker-item brand">⚡ XILINX ARTIX-7 VERIFICATION</span>
        <span class="ticker-item highlight">◆ FIRST-CLASS HONOURS (80% ACCREDITED)</span>
        <span class="ticker-item">★ 91% DISSERTATION DISTINCTION</span>
      </div>
      <div class="ticker-content" aria-hidden="true">
        <span class="ticker-item highlight">◆ VAIDAR HIL FRAMEWORK</span>
        <span class="ticker-item">★ THE IET PRIZE 2026 WINNER</span>
        <span class="ticker-item brand">⚡ CHESS DYNAMICS DEFENCE OPTRONICS</span>
        <span class="ticker-item">◆ BAE SYSTEMS IV&amp;V AVIONICS</span>
        <span class="ticker-item brand">⚡ XILINX ARTIX-7 VERIFICATION</span>
        <span class="ticker-item highlight">◆ FIRST-CLASS HONOURS (80% ACCREDITED)</span>
        <span class="ticker-item">★ 91% DISSERTATION DISTINCTION</span>
      </div>
    </div>
  </div>

  <!-- Featured Projects -->
  <section class="section">
    <div class="container">
      <div class="section-header">
        <div>
          <p class="eyebrow">Portfolio</p>
          <h2>Featured Engineering Projects</h2>
        </div>
        <a class="view-all" href="/projects">All projects ({allProjects.length}) →</a>
      </div>

      <div class="grid grid-2">
        {featuredProjects.map((project) => (
          <ProjectCard project={project} />
        ))}
      </div>
    </div>
  </section>

  <!-- About Snapshot & Core Specialisms -->
  <section class="section highlight-section">
    <div class="container">
      <div class="grid grid-2">
        <div class="card">
          <p class="eyebrow">Background</p>
          <h3>Defence Testing &amp; FPGA Verification</h3>
          <p class="muted">
            Specializing in military-grade electro-optical surveillance system testing, hardware-in-the-loop (HIL)
            validation rigs, and automated digital logic verification. Experienced in both high-reliability aerospace 
            (BAE Systems placement) and land/maritime defence directors (Chess Dynamics).
          </p>
          <div class="actions">
            <a class="btn ghost" href="/about">Full Biography →</a>
            <a class="btn ghost" href={profile.cvPdf} download>Download CV (PDF)</a>
          </div>
        </div>

        <div class="card">
          <p class="eyebrow">Technical Domains</p>
          <h3>Core Competencies</h3>
          <div class="skills-mini-grid">
            <div class="skill-category">
              <h4>Digital Logic &amp; RTL</h4>
              <p class="muted">Verilog HDL, VHDL, Vivado, Artix-7, FSM design, timing closure.</p>
            </div>
            <div class="skill-category">
              <h4>HIL Automation</h4>
              <p class="muted">Python test engines, PySerial, PyVISA, automated fault triage.</p>
            </div>
            <div class="skill-category">
              <h4>Instrumentation &amp; Bus</h4>
              <p class="muted">Oscilloscopes, logic analysers, UART, SPI, I2C, MIL-STD-1553.</p>
            </div>
            <div class="skill-category">
              <h4>Embedded &amp; DSP</h4>
              <p class="muted">PIC microcontrollers, MPLAB XC8, MATLAB App Designer, Simulink.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Industry Experience Highlight -->
  <section class="section">
    <div class="container">
      <div class="section-header">
        <div>
          <p class="eyebrow">Career &amp; Industry</p>
          <h2>Professional Work Experience</h2>
        </div>
        <a class="view-all" href="/experience">All experience &amp; details →</a>
      </div>

      <div class="grid grid-2">
        <article class="card">
          <div class="badge-header" style="margin-bottom: 0.5rem;">
            <span class="pulse-dot"></span>
            <span class="status-text" style="color: var(--brand);">Current Role • Defence Electro-Optics</span>
          </div>
          <h3>Hardware Test Engineer</h3>
          <p class="company-line" style="margin: 0.25rem 0 0.75rem; color: var(--muted); font-size: 0.95rem;">
            <strong>Chess Dynamics</strong> • June 2026 – Present
          </p>
          <p class="muted" style="margin-bottom: 1rem; line-height: 1.5;">
            Leading system-level integration, qualification testing, and cross-functional diagnostics on precision electro-optical surveillance and fire-control directors for maritime and land defence.
          </p>
          <div class="tech-stack-row">
            <span class="tag">FAT / SAT Testing</span>
            <span class="tag">Environmental Chambers</span>
            <span class="tag">RS-422 / CAN Bus</span>
          </div>
        </article>

        <article class="card">
          <div class="badge-header" style="margin-bottom: 0.5rem;">
            <span class="status-text" style="color: var(--muted); font-weight: 600;">12-Month Industrial Placement</span>
          </div>
          <h3>Systems Engineer - IV&amp;V</h3>
          <p class="company-line" style="margin: 0.25rem 0 0.75rem; color: var(--muted); font-size: 0.95rem;">
            <strong>BAE Systems</strong> • June 2024 – June 2025
          </p>
          <p class="muted" style="margin-bottom: 1rem; line-height: 1.5;">
            Integration, Verification &amp; Validation for tier-one defence aerospace systems. Authored automated Python regression test suites and managed requirement traceability matrices in IBM DOORS.
          </p>
          <div class="tech-stack-row">
            <span class="tag">Python Automation</span>
            <span class="tag">IBM DOORS (DXL)</span>
            <span class="tag">Avionics Testbenches</span>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- LinkedIn Feed & Recent Updates -->
  <section class="section">
    <div class="container">
      <div class="section-header">
        <div>
          <p class="eyebrow">Professional Network</p>
          <h2>Recent LinkedIn Updates</h2>
        </div>
        <a class="view-all" href={profile.links.linkedin} target="_blank" rel="noopener noreferrer">
          View LinkedIn Profile →
        </a>
      </div>

      <LinkedInFeed />
    </div>
  </section>
</BaseLayout>

<style>
  .hero-section { padding-top: 4.5rem; padding-bottom: 3.5rem; }
  .hero-container { display: grid; grid-template-columns: 1.25fr 0.75fr; gap: 3rem; align-items: center; }
  
  .telemetry-pill-row { display: flex; flex-wrap: wrap; gap: 0.6rem; margin-bottom: 1.25rem; }
  .telemetry-pill {
    display: inline-flex; align-items: center; gap: 0.4rem;
    padding: 0.3rem 0.75rem; border-radius: 9999px;
    background: color-mix(in srgb, var(--surface) 90%, transparent);
    border: 1px solid var(--border); font-size: 0.75rem; font-family: var(--font-mono);
  }
  .telemetry-pill-label { color: var(--muted); font-weight: 500; }
  .telemetry-pill-val { color: var(--brand); font-weight: 700; letter-spacing: 0.04em; }
  .telemetry-pill.secondary { opacity: 0.9; }

  .hero-title { font-size: clamp(2.4rem, 4.5vw, 3.8rem); font-weight: 900; line-height: 1.05; letter-spacing: -0.02em; margin-bottom: 1.25rem; text-transform: uppercase; }
  .gradient-text { background: linear-gradient(135deg, var(--brand) 0%, #00d2ff 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
  .hero-subtitle { font-size: 1.12rem; color: var(--muted); line-height: 1.6; max-width: 38rem; }
  
  .hero-badge-card { display: flex; flex-direction: column; gap: 1.25rem; padding: 1.75rem; border-color: color-mix(in srgb, var(--brand) 25%, var(--border)); box-shadow: var(--shadow); }
  .badge-header { display: flex; align-items: center; justify-content: space-between; font-size: 0.8rem; font-family: var(--font-mono); font-weight: 700; }
  .status-title { color: var(--muted); letter-spacing: 0.08em; }
  .channel-badge { background: color-mix(in srgb, var(--brand) 15%, transparent); color: var(--brand); padding: 0.15rem 0.5rem; border-radius: 4px; border: 1px solid color-mix(in srgb, var(--brand) 30%, transparent); font-size: 0.75rem; }
  
  .pulse-dot { width: 8px; height: 8px; border-radius: 50%; background: #10b981; box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.2); }
  .badge-stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.75rem; list-style: none; padding: 0; margin: 0; text-align: center; }
  .badge-stats li { background: var(--surface-2); padding: 0.75rem 0.5rem; border-radius: 8px; border: 1px solid var(--border); }
  .stat-number { display: block; font-size: 1.75rem; font-weight: 900; color: var(--text); font-family: var(--font-mono); }
  .accent-num { color: var(--brand); }
  .stat-label { font-size: 0.7rem; text-transform: uppercase; color: var(--muted); letter-spacing: 0.05em; font-weight: 600; }
  
  .telemetry-sim-box { background: var(--surface-2); border: 1px solid var(--border); border-radius: 8px; padding: 0.75rem 0.9rem; font-family: var(--font-mono); font-size: 0.75rem; }
  .telemetry-sim-header { display: flex; justify-content: space-between; color: var(--muted); font-size: 0.7rem; font-weight: 600; margin-bottom: 0.4rem; }
  .rate-indicator { color: #10b981; font-weight: 700; }
  .progress-bar-bg { width: 100%; height: 5px; background: color-mix(in srgb, var(--border) 60%, transparent); border-radius: 9999px; overflow: hidden; margin-bottom: 0.5rem; }
  .progress-bar-fill { width: 78%; height: 100%; background: linear-gradient(90deg, var(--brand), #00d2ff); border-radius: 9999px; animation: sim-pulse 4s ease-in-out infinite alternate; }
  @keyframes sim-pulse { 0% { width: 65%; } 100% { width: 92%; } }
  .telemetry-msg { display: flex; align-items: center; gap: 0.4rem; color: var(--text); font-size: 0.75rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .live-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--brand); animation: pulse-blink 1.8s infinite; }
  @keyframes pulse-blink { 0%, 100% { opacity: 1; } 50% { opacity: 0.3; } }

  .tech-stack-row { display: flex; flex-wrap: wrap; gap: 0.4rem; }

  /* Ticker Banner */
  .ticker-banner {
    border-top: 1px solid var(--border); border-bottom: 1px solid var(--border);
    background: var(--surface-2); overflow: hidden; padding: 0.75rem 0;
    user-select: none;
  }
  .ticker-track { display: flex; width: max-content; }
  .ticker-content { display: flex; animation: marquee-scroll 24s linear infinite; white-space: nowrap; font-family: var(--font-mono); font-size: 0.8rem; }
  .ticker-item { margin: 0 1.5rem; color: var(--muted); }
  .ticker-item.highlight { color: var(--text); font-weight: 700; }
  .ticker-item.brand { color: var(--brand); font-weight: 700; }
  @keyframes marquee-scroll { 0% { transform: translateX(0); } 100% { transform: translateX(-50%); } }

  .section-header { display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 2rem; }
  .view-all { color: var(--brand); text-decoration: none; font-weight: 600; font-size: 0.95rem; }
  .view-all:hover { text-decoration: underline; }

  .skills-mini-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-top: 1rem; }
  .skill-category h4 { margin: 0 0 0.25rem; font-size: 0.95rem; }
  .skill-category p { font-size: 0.85rem; margin: 0; }

  @media (max-width: 900px) {
    .hero-container { grid-template-columns: 1fr; gap: 2rem; }
  }
  @media (max-width: 600px) {
    .skills-mini-grid { grid-template-columns: 1fr; }
  }
</style>
