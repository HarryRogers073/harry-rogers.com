---
/**
 * =============================================================================
 * File:         index.astro
 * Written by:   Harry Rogers
 * Date:         October 2026
 * Description:  Projects index showcase focusing on engineering outcomes and capabilities
 * =============================================================================
 */

import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getCollection } from 'astro:content';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);

const capabilities = [
  {
    discipline: "FPGA & Hardware Verification",
    badge: "Silicon Validation",
    description:
      "Physical silicon Hardware-in-the-Loop testbeds streaming automated Python stimulus into physical AMD Xilinx Artix-7 and Intel Cyclone FPGAs at 968.9 tests/second. Automated anomaly triage, timing closure, and Vivado/ModelSim verification.",
    keyOutcomes: [
      "968.9 tests/sec physical throughput across 921,600 baud serial bridge",
      "Automated discrepancy triage comparing physical silicon against golden reference models",
      "RTL state machines, 16-bit ALU datapaths, and synchronous arbitration queues in Verilog & VHDL",
    ],
    relatedLink: "/projects/vaidar-hil-framework",
    relatedTitle: "VAIDAR HIL Framework",
  },
  {
    discipline: "Autonomous Robotics & Control",
    badge: "Hardware & Firmware",
    description:
      "Embedded C control software, multi-microcontroller distributed architectures, and custom discrete motor drivers for autonomous corridor-navigating platforms and combat robotics.",
    keyOutcomes: [
      "2nd Place podium finish in inter-collegiate combat robotics arena tournament",
      "Dual PIC microcontroller task partitioning with calibrated ADC thermistor and sonar evasion",
      "High-current MOSFET H-bridge motor controllers with PWM speed modulation",
    ],
    relatedLink: "/projects/robot-wars-combat-platform",
    relatedTitle: "Combat Robotics Platform",
  },
  {
    discipline: "Low-Level Firmware & Microprocessors",
    badge: "Cycle-Accurate Assembly",
    description:
      "Bare-metal assembly firmware targeting Microchip PIC microcontrollers. Direct hardware register manipulation, interrupt-driven peripherals, and full-duplex communication protocols.",
    keyOutcomes: [
      "Cycle-accurate MPASM assembly routines for PIC16F873 and PIC16F84A",
      "Full-duplex master-slave communications bus and parallel display latching",
      "Timer 2 register configuration and CCP1 module PWM duty modulation",
    ],
    relatedLink: "/projects/pic-microcontroller-code",
    relatedTitle: "PIC Microcontroller Library",
  },
  {
    discipline: "Telecommunications & Networking",
    badge: "Network Architecture",
    description:
      "Multi-site WAN topological design, enterprise routing architectures, wireless network infrastructure, and radio frequency sensing research.",
    keyOutcomes: [
      "Layer 3 hierarchical WAN routing with V.35 serial DTE/DCE topologies in Cisco Packet Tracer",
      "WPA2-PSK enterprise wireless infrastructure and IoT event-triggered automation",
      "Channel State Information (CSI) evaluating human presence sensing using Software-Defined Radios",
    ],
    relatedLink: "/projects/communications-network-architecture",
    relatedTitle: "WAN & RF Architecture",
  },
  {
    discipline: "Virtual Instrumentation & DSP",
    badge: "Signal Processing",
    description:
      "Custom interactive desktop telemetry applications, digital filter synthesis, and dynamic audio processing pipelines in MATLAB and Simulink.",
    keyOutcomes: [
      "Dual-channel real-time desktop oscilloscope turning external microcontrollers into lab instruments",
      "11th-order Butterworth IIR and 324th-order Hamming FIR filter synthesis with Bilinear Transformation",
      "Dynamic 3-band audio crossover and synthesiseable RTL IP core export via HDL Coder",
    ],
    relatedLink: "/projects/matlab-projects",
    relatedTitle: "MATLAB Engineering Suite",
  },
];

---

<BaseLayout
  title="Engineering Projects & Systems"
  description="Portfolio of FPGA verification, embedded systems, networking, and robotics engineering projects by Harry Rogers."
>
  <section class="section">
    <div class="container">
      <div class="header-intro">
        <p class="eyebrow">Engineering Portfolio</p>
        <h1>Projects &amp; Technical Systems</h1>
        <p class="muted intro">
          Hardware-in-the-loop testbeds, FPGA digital architectures, autonomous robotics, low-level firmware libraries, and telecommunications simulations built across academia and industry.
        </p>
      </div>

      <!-- Flagship Case Studies Grid -->
      <div class="section-subhead">
        <h2>Flagship Engineering Projects</h2>
        <p class="muted">Detailed project breakdowns with hardware schematics, physical silicon testbeds, and source code repositories.</p>
      </div>

      <div class="grid grid-2 project-list">
        {projects.map((project) => (
          <ProjectCard project={project} />
        ))}
      </div>

      <!-- Core Technical Competencies & Systems Capabilities -->
      <div class="capabilities-section">
        <div class="section-subhead">
          <p class="eyebrow">Technical Competencies</p>
          <h2>Engineering Disciplines &amp; System Capabilities</h2>
          <p class="muted">
            Key engineering capabilities and verified technical outcomes demonstrated across physical hardware, digital logic, and software automation.
          </p>
        </div>

        <div class="capabilities-grid">
          {capabilities.map((cap) => (
            <div class="capability-card card">
              <div class="capability-header">
                <h3>{cap.discipline}</h3>
                <span class="cap-badge">{cap.badge}</span>
              </div>
              <p class="cap-desc muted">{cap.description}</p>
              
              <div class="outcomes-box">
                <span class="outcomes-title font-mono">Key Technical Outcomes</span>
                <ul class="outcomes-list">
                  {cap.keyOutcomes.map((outcome) => (
                    <li>{outcome}</li>
                  ))}
                </ul>
              </div>

              <div class="cap-footer">
                <a href={cap.relatedLink} class="cap-link">
                  <span>Explore Case Study: <strong>{cap.relatedTitle}</strong></span>
                  <span class="arrow">→</span>
                </a>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Academic Transcript Callout Banner -->
      <div class="academic-callout card">
        <div class="callout-content">
          <div class="callout-pill">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/></svg>
            <span>Academic Credentials &amp; Transcripts</span>
          </div>
          <h3>Looking for Year-by-Year Academic Grades?</h3>
          <p class="muted">
            All 17 university module marks across all three years, First-Class Honours (80%) classification, 
            and The IET Prize 2026 citation are comprehensively documented in the Curriculum Vitae.
          </p>
        </div>
        <div class="callout-actions">
          <a href="/cv#education-modules" class="btn btn-primary">
            View Academic Transcript on CV →
          </a>
        </div>
      </div>

    </div>
  </section>
</BaseLayout>

<style>
  .header-intro { max-width: 50rem; margin-bottom: 2.5rem; }
  .intro { font-size: 1.15rem; line-height: 1.6; margin-top: 0.5rem; }
  .section-subhead { margin: 3rem 0 1.5rem; }
  .section-subhead h2 { font-size: 1.75rem; margin-bottom: 0.25rem; }
  .project-list { margin-top: 1.5rem; }

  /* Capabilities Section */
  .capabilities-section {
    margin-top: 4.5rem;
    border-top: 1px solid var(--border);
    padding-top: 3rem;
  }
  .capabilities-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
    gap: 1.5rem;
    margin-top: 2rem;
  }
  .capability-card {
    display: flex;
    flex-direction: column;
    padding: 1.75rem;
    border-radius: 12px;
    border: 1px solid var(--border);
    background: var(--surface);
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.2s ease, box-shadow 0.2s ease;
  }
  .capability-card:hover {
    transform: translateY(-3px);
    border-color: color-mix(in srgb, var(--brand) 60%, var(--border));
    box-shadow: 0 12px 28px -10px rgba(0, 0, 0, 0.14);
  }
  .capability-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
    margin-bottom: 0.75rem;
  }
  .capability-header h3 {
    font-size: 1.25rem;
    margin: 0;
    line-height: 1.3;
  }
  .cap-badge {
    font-size: 0.72rem;
    font-weight: 700;
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding: 0.25rem 0.65rem;
    border-radius: 9999px;
    background: var(--surface-2);
    border: 1px solid var(--border);
    color: var(--brand);
    white-space: nowrap;
  }
  .cap-desc {
    font-size: 0.95rem;
    line-height: 1.55;
    margin-bottom: 1.25rem;
  }
  .outcomes-box {
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 1rem 1.15rem;
    margin-bottom: 1.25rem;
    flex: 1;
  }
  .outcomes-title {
    display: block;
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--muted);
    margin-bottom: 0.6rem;
  }
  .outcomes-list {
    margin: 0;
    padding-left: 1.15rem;
    font-size: 0.88rem;
    line-height: 1.5;
    color: var(--text);
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }
  .cap-footer {
    border-top: 1px solid var(--border);
    padding-top: 1rem;
    margin-top: auto;
  }
  .cap-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.88rem;
    color: var(--brand);
    text-decoration: none;
    font-weight: 500;
    transition: transform 0.15s ease;
  }
  .cap-link:hover .arrow {
    transform: translateX(4px);
  }
  .cap-link .arrow {
    transition: transform 0.2s ease;
  }

  /* Academic Callout Banner */
  .academic-callout {
    margin-top: 4rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    padding: 2.25rem;
    border-radius: 12px;
    background: linear-gradient(135deg, var(--surface) 0%, var(--surface-2) 100%);
    border: 1px solid color-mix(in srgb, var(--brand) 30%, var(--border));
  }
  .callout-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.75rem;
    font-family: var(--font-mono);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--brand);
    margin-bottom: 0.5rem;
  }
  .callout-content h3 {
    font-size: 1.4rem;
    margin: 0 0 0.5rem;
  }
  .callout-content p {
    font-size: 0.95rem;
    line-height: 1.55;
    margin: 0;
    max-width: 44rem;
  }
  .callout-actions {
    flex-shrink: 0;
  }

  @media (max-width: 768px) {
    .academic-callout {
      flex-direction: column;
      align-items: flex-start;
      gap: 1.25rem;
      padding: 1.5rem;
    }
  }
</style>
