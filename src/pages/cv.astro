---
import BaseLayout from '../layouts/BaseLayout.astro';
import { profile, experience, education, skills, leadership, otherWork } from '../data/profile';
---

<BaseLayout title="Curriculum Vitae" description="Master Curriculum Vitae for Harry Rogers: Test & FPGA Verification Engineer, IET Prize Winner 2026.">
  <section class="section cv-section">
    <div class="container cv-container">
      
      <!-- Top Action Bar -->
      <div class="cv-actions-bar">
        <a class="btn" href={profile.cvPdf} download="Harry_Rogers_Master_CV.pdf">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3"/></svg>
          Download Master CV (PDF)
        </a>
        <button class="btn ghost print-btn" onclick="window.print()">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="6 9 6 2 18 2 18 9"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect x="6" y="14" width="12" height="8"/></svg>
          Print CV
        </button>
      </div>

      <!-- CV Header -->
      <header class="cv-header card">
        <div class="cv-title-group">
          <h1>{profile.name}</h1>
          <p class="role-title">{profile.title}</p>
          <p class="location-text">
            <span>📍 {profile.location}</span>
            <span>•</span>
            <a href={`mailto:${profile.email}`}>{profile.email}</a>
            <span>•</span>
            <a href={profile.links.linkedin} target="_blank" rel="noopener">LinkedIn</a>
            <span>•</span>
            <a href={profile.links.github} target="_blank" rel="noopener">GitHub</a>
          </p>
        </div>
        <div class="awards-badge-box">
          <div class="award-tag">
            <span class="award-icon">🏆</span>
            <div>
              <strong>The IET Prize 2026</strong>
              <span class="muted award-sub">Institution of Engineering and Technology</span>
            </div>
          </div>
          <div class="award-tag">
            <span class="award-icon">🎓</span>
            <div>
              <strong>First-Class Honours (80%)</strong>
              <span class="muted award-sub">BEng Electronic &amp; Computer Eng</span>
            </div>
          </div>
        </div>
      </header>

      <!-- Professional Experience -->
      <section class="cv-block">
        <h2 class="cv-heading">Professional Work Experience</h2>
        <div class="experience-list">
          {experience.map((job) => (
            <article class="cv-item card">
              <div class="cv-item-header">
                <div>
                  <h3>{job.role}</h3>
                  <p class="company-name">{job.company} — <span class="muted">{job.location}</span></p>
                </div>
                <span class="period-pill">{job.period}</span>
              </div>
              <ul class="highlights-list">
                {job.highlights.map((h) => (
                  <li>{h}</li>
                ))}
              </ul>
            </article>
          ))}
        </div>
      </section>

      <!-- Education & Academic Performance -->
      <section class="cv-block">
        <h2 class="cv-heading">Education &amp; Academic Honors</h2>
        <div class="cv-item card">
          <div class="cv-item-header">
            <div>
              <h3>{education.degree}</h3>
              <p class="company-name">{education.institution} — <strong>{education.result}</strong></p>
            </div>
            <span class="period-pill">{education.period}</span>
          </div>

          <div class="modules-breakdown">
            <h4>Academic Performance &amp; Grades:</h4>
            <div class="modules-grid">
              {education.modules.map((m) => (
                <div class="module-level-box">
                  <h5>{m.level}</h5>
                  <ul>
                    {m.items.map(([name, grade]) => (
                      <li>
                        <span>{name}</span>
                        <strong class={grade >= 80 ? 'grade-high' : 'grade-mid'}>{grade}%</strong>
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
          </div>
        </div>
      </section>

      <!-- Technical Skills Matrix -->
      <section class="cv-block">
        <h2 class="cv-heading">Technical Skills Matrix</h2>
        <div class="skills-card card">
          {Object.entries(skills).map(([category, list]) => (
            <div class="skill-category-row">
              <h4>{category}</h4>
              <ul class="tags">
                {list.map((item) => (
                  <li class="tag">{item}</li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </section>

      <!-- Additional Experience & Leadership -->
      <section class="cv-block">
        <div class="grid grid-2">
          <div class="card">
            <h3 class="minor-heading">Leadership &amp; Societies</h3>
            <ul class="compact-list">
              {leadership.map((l) => (
                <li>
                  <strong>{l.role}</strong>
                  <span class="muted"> — {l.org} ({l.period})</span>
                </li>
              ))}
            </ul>
          </div>

          <div class="card">
            <h3 class="minor-heading">Additional Experience</h3>
            <ul class="compact-list">
              {otherWork.map((w) => (
                <li>
                  <strong>{w.role}</strong>
                  <span class="muted"> — {w.company} ({w.period})</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </section>

    </div>
  </section>
</BaseLayout>

<style>
  .cv-container { max-width: 54rem; }
  .cv-actions-bar { display: flex; justify-content: flex-end; gap: 0.75rem; margin-bottom: 2rem; }
  .cv-header { display: flex; justify-content: space-between; align-items: flex-start; gap: 2rem; margin-bottom: 2.5rem; flex-wrap: wrap; }
  .cv-title-group h1 { margin: 0 0 0.25rem; font-size: 2.4rem; }
  .role-title { font-size: 1.2rem; color: var(--brand); font-weight: 600; margin: 0 0 0.5rem; }
  .location-text { display: flex; flex-wrap: wrap; gap: 0.5rem; font-size: 0.9rem; color: var(--muted); margin: 0; }
  .location-text a { color: var(--muted); text-decoration: none; }
  .location-text a:hover { color: var(--brand); }

  .awards-badge-box { display: flex; flex-direction: column; gap: 0.75rem; }
  .award-tag { display: flex; align-items: center; gap: 0.75rem; padding: 0.6rem 0.9rem; background: var(--surface-2); border: 1px solid var(--border); border-radius: 10px; font-size: 0.85rem; }
  .award-icon { font-size: 1.3rem; }
  .award-sub { display: block; font-size: 0.75rem; }

  .cv-block { margin-bottom: 2.5rem; }
  .cv-heading { font-size: 1.35rem; margin: 0 0 1.25rem; padding-bottom: 0.5rem; border-bottom: 2px solid var(--border); text-transform: uppercase; letter-spacing: 0.05em; color: var(--text); }
  .experience-list { display: flex; flex-direction: column; gap: 1.25rem; }
  
  .cv-item-header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 0.75rem; flex-wrap: wrap; gap: 0.5rem; }
  .cv-item-header h3 { margin: 0 0 0.2rem; font-size: 1.2rem; }
  .company-name { font-size: 0.95rem; margin: 0; }
  .period-pill { font-family: var(--font-mono); font-size: 0.8rem; background: var(--surface-2); border: 1px solid var(--border); padding: 0.2rem 0.6rem; border-radius: 999px; color: var(--muted); }

  .highlights-list { padding-left: 1.2rem; margin: 0; }
  .highlights-list li { margin: 0.35rem 0; font-size: 0.97rem; }

  .modules-breakdown { margin-top: 1.5rem; border-top: 1px dashed var(--border); padding-top: 1rem; }
  .modules-breakdown h4 { font-size: 0.95rem; margin: 0 0 0.75rem; color: var(--muted); }
  .modules-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; }
  .module-level-box h5 { margin: 0 0 0.5rem; font-size: 0.9rem; color: var(--brand); }
  .module-level-box ul { list-style: none; padding: 0; margin: 0; font-size: 0.88rem; }
  .module-level-box li { display: flex; justify-content: space-between; padding: 0.25rem 0; border-bottom: 1px solid color-mix(in srgb, var(--border) 50%, transparent); }
  .grade-high { color: #059669; }
  .grade-mid { color: var(--brand); }

  .skill-category-row { margin-bottom: 1.2rem; }
  .skill-category-row:last-child { margin-bottom: 0; }
  .skill-category-row h4 { margin: 0 0 0.5rem; font-size: 0.9rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--muted); }

  .minor-heading { font-size: 1.1rem; margin: 0 0 1rem; }
  .compact-list { list-style: none; padding: 0; margin: 0; font-size: 0.9rem; }
  .compact-list li { padding: 0.4rem 0; border-bottom: 1px solid color-mix(in srgb, var(--border) 50%, transparent); }
  .compact-list li:last-child { border-bottom: none; }

  @media (max-width: 700px) {
    .modules-grid { grid-template-columns: 1fr; }
  }

  @media print {
    :global(.site-header), :global(.site-footer), .cv-actions-bar { display: none !important; }
    body { background: #fff !important; color: #000 !important; font-size: 10pt; }
    .card { border: none !important; box-shadow: none !important; padding: 0 !important; }
    .cv-section { padding: 0 !important; }
  }
</style>
