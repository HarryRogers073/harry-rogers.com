---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { title, description, date, tags } = post.data;
const { Content } = await render(post);
---

<BaseLayout title={title} description={description} type="article">
  <article class="section">
    <div class="container article-layout">
      <nav class="breadcrumb">
        <a href="/blog">← Back to all posts</a>
      </nav>

      <header class="article-header">
        <time datetime={date.toISOString()} class="muted">
          {date.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}
        </time>
        <h1>{title}</h1>
        <p class="summary">{description}</p>
        <ul class="tags">
          {tags.map((t) => <li class="tag">{t}</li>)}
        </ul>
      </header>

      <hr />

      <div class="prose article-body">
        <Content />
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .article-layout { max-width: 48rem; }
  .breadcrumb { margin-bottom: 2rem; font-size: 0.95rem; }
  .breadcrumb a { color: var(--muted); text-decoration: none; font-weight: 500; }
  .breadcrumb a:hover { color: var(--brand); }
  .article-header h1 { margin: 0.5rem 0 1rem; }
  .summary { font-size: 1.2rem; color: var(--muted); line-height: 1.5; margin-bottom: 1rem; }
  .article-body { margin-top: 2.5rem; }
</style>
