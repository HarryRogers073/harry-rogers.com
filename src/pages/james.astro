    letter-spacing: 0.06em;
    padding: 0.35rem 0.85rem;
    border-radius: 999px;
    background: var(--surface);
    border: 1px solid var(--border);
    box-shadow: 0 0 12px rgba(220, 38, 38, 0.15);
  }
  .dracula-tag { color: #ef4444; }
  .pill-divider { color: var(--muted); }
  .zombie-tag { color: #22c55e; }

  .linkedin-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    padding: 0.35rem 0.85rem;
    border-radius: 999px;
    background: color-mix(in srgb, #0077b5 15%, var(--surface));
    color: #0077b5;
    border: 1px solid color-mix(in srgb, #0077b5 35%, transparent);
    text-decoration: none;
    transition: all 0.15s ease;
  }
  .linkedin-pill:hover {
    background: #0077b5;
    color: #fff;
    transform: translateY(-1px);
  }

  .hero-title {
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 5vw, 3.8rem);
