    z-index: 9999;
    opacity: 0;
    background: radial-gradient(circle, rgba(255, 255, 255, 0.9) 0%, rgba(220, 38, 38, 0.6) 40%, rgba(34, 197, 94, 0.8) 100%);
  }

  .lightning-overlay.active-flash {
    animation: lightning-strobe 0.4s ease-out;
  }

  @keyframes lightning-strobe {
    0% { opacity: 0.95; }
    15% { opacity: 0.2; }
    30% { opacity: 0.85; }
    45% { opacity: 0.1; }
    60% { opacity: 0.6; }
    100% { opacity: 0; }
  }

  /* Screen tremor on lightning trigger */
  .violent-rumble {
    animation: screen-shake 0.35s cubic-bezier(.36,.07,.19,.97) both;
  }
  @keyframes screen-shake {
    10%, 90% { transform: translate3d(-3px, 0, 0); }
    20%, 80% { transform: translate3d(4px, 0, 0); }
    30%, 50%, 70% { transform: translate3d(-6px, 0, 0); }
    40%, 60% { transform: translate3d(6px, 0, 0); }
  }

  /* Top Hazard Caution Banner */
  .jagged-hazard-strip {
    background: repeating-linear-gradient(
      -45deg,
      #dc2626,
      #dc2626 14px,
      #040507 14px,
      #040507 24px,
      #16a34a 24px,
      #16a34a 38px
    );
    color: #fff;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 900;
    letter-spacing: 0.1em;
    padding: 0.45rem 1rem;
    overflow: hidden;
    white-space: nowrap;
    border-bottom: 2px solid #dc2626;
    text-shadow: 0 0 6px #000;
  }

  .hazard-repeat {
    display: inline-block;
    animation: marquee-scroll 25s linear infinite;
  }

  @keyframes marquee-scroll {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }

  /* Hero Section */
  .james-hero {
    padding: 3rem 0 2.5rem;
    position: relative;
    border-bottom: 1px solid #1f2937;
    background: radial-gradient(circle at 20% 0%, rgba(220, 38, 38, 0.22) 0%, transparent 55%),
                radial-gradient(circle at 80% 0%, rgba(34, 197, 94, 0.22) 0%, transparent 55%),
                linear-gradient(180deg, #0a0406 0%, #040806 100%);
  }

  .hero-top-badges {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-bottom: 1.5rem;
  }

  /* Jagged Polygon Cut Corners */
  .jagged-pill {
    clip-path: polygon(8px 0, 100% 0, calc(100% - 8px) 100%, 0 100%);
    border-radius: 0 !important;
  }

  .hybrid-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    padding: 0.45rem 1.1rem;
    background: #09090d;
    border: 1px solid #dc2626;
    box-shadow: 0 0 15px rgba(220, 38, 38, 0.4);
  }
  .dracula-tag { color: #ef4444; text-shadow: 0 0 8px rgba(239, 68, 68, 0.6); }
  .pill-divider { color: #facc15; }
  .zombie-tag { color: #22c55e; text-shadow: 0 0 8px rgba(34, 197, 94, 0.6); }

  .strobe-trigger-btn {
    background: linear-gradient(135deg, #dc2626 0%, #16a34a 100%);
    color: #fff;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 900;
    letter-spacing: 0.08em;
    padding: 0.45rem 1rem;
    border: 1px solid #fff;
    cursor: pointer;
    clip-path: polygon(6px 0, 100% 0, calc(100% - 6px) 100%, 0 100%);
    box-shadow: 0 0 15px rgba(255, 255, 255, 0.4);
    animation: strobe-glow 1.5s infinite alternate;
    transition: transform 0.1s;
  }
  .strobe-trigger-btn:hover {
    transform: scale(1.05);
  }

  @keyframes strobe-glow {
    0% { box-shadow: 0 0 10px #dc2626; }
    50% { box-shadow: 0 0 20px #facc15; }
    100% { box-shadow: 0 0 10px #22c55e; }
  }

  .linkedin-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    padding: 0.45rem 1rem;
    background: #022030;
    color: #38bdf8;
    border: 1px solid #0284c7;
    text-decoration: none;
    transition: all 0.15s ease;
  }
  .linkedin-pill:hover {
    background: #0284c7;
    color: #fff;
    box-shadow: 0 0 15px #38bdf8;
  }

  .hero-eyebrow {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    letter-spacing: 0.2em;
    color: #dc2626;
    margin-bottom: 0.25rem;
    text-shadow: 0 0 10px #dc2626;
  }

  .hero-title {
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 6vw, 4.4rem);
    line-height: 1.05;
    font-weight: 900;
    margin: 0 0 1.5rem;
    letter-spacing: -0.03em;
  }

  /* Flashy Chromatic Extreme Glitch Name */
  .extreme-glitch-name {
    display: inline-block;
    background: linear-gradient(135deg, #ff0055 0%, #dc2626 25%, #ffffff 50%, #4ade80 75%, #00ff66 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    text-decoration: none;
    position: relative;
    text-shadow: 2px 2px 10px rgba(220, 38, 38, 0.7), -2px -2px 10px rgba(34, 197, 94, 0.7);
    animation: name-pulse-glow 3s infinite alternate;
  }

  @keyframes name-pulse-glow {
    0% { filter: drop-shadow(0 0 15px rgba(220, 38, 38, 0.8)); }
    50% { filter: drop-shadow(0 0 25px rgba(255, 255, 255, 0.9)); }
    100% { filter: drop-shadow(0 0 15px rgba(34, 197, 94, 0.8)); }
  }

  /* Jagged Polygonal Card Architecture */
  .jagged-card {
    clip-path: polygon(
      0 16px,
      16px 0,
      calc(100% - 24px) 0,
      100% 24px,
      100% calc(100% - 16px),
      calc(100% - 16px) 100%,
      24px 100%,
      0 calc(100% - 24px)
    );
    border-radius: 0 !important;
    position: relative;
    background: #09090e;
    border: 2px solid #27272a;
  }

  .jagged-box {
    clip-path: polygon(0 0, calc(100% - 12px) 0, 100% 12px, 100% 100%, 12px 100%, 0 calc(100% - 12px));
    border-radius: 0 !important;
  }

  .jagged-inner-box {
    clip-path: polygon(0 8px, 8px 0, 100% 0, 100% calc(100% - 8px), calc(100% - 8px) 100%, 0 100%);
    border-radius: 0 !important;
  }

  /* Profile Highlight Card with Dual Blood & Acid Glow */
  .profile-highlight-box {
    padding: 1.8rem 2rem;
    margin-bottom: 2.25rem;
    background: #080509;
    border-color: #7f1d1d;
    box-shadow: -6px 0 30px rgba(220, 38, 38, 0.35), 6px 0 30px rgba(34, 197, 94, 0.35);
  }

  .profile-header-split {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1.5rem;
  }

  .profile-text-side {
    max-width: 48rem;
  }

  .role-location-line {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex-wrap: wrap;
    margin-bottom: 0.85rem;
  }

  .firm-tag {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    font-weight: 800;
    padding: 0.25rem 0.65rem;
    border: 1px solid;
    clip-path: polygon(4px 0, 100% 0, calc(100% - 4px) 100%, 0 100%);
  }
  .dracula-tag-line {
    color: #ef4444;
    border-color: #ef4444;
    background: rgba(239, 68, 68, 0.12);
    box-shadow: 0 0 10px rgba(239, 68, 68, 0.3);
  }
  .zombie-tag-line {
    color: #22c55e;
    border-color: #22c55e;
    background: rgba(34, 197, 94, 0.12);
    box-shadow: 0 0 10px rgba(34, 197, 94, 0.3);
  }
  .firm-tag.ranking {
    color: #f8fafc;
    border-color: #475569;
    background: #0f172a;
  }

  .loc-text {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: #94a3b8;
  }

  .profile-summary-text {
    font-size: 1.02rem;
    line-height: 1.65;
    margin: 0;
    color: #e2e8f0;
  }

  .extreme-cta-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: linear-gradient(135deg, #dc2626 0%, #000 50%, #16a34a 100%);
    color: #fff;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    font-weight: 800;
    padding: 0.85rem 1.5rem;
    border: 2px solid #ef4444;
    text-decoration: none;
    clip-path: polygon(8px 0, 100% 0, calc(100% - 8px) 100%, 0 100%);
    box-shadow: 0 0 20px rgba(220, 38, 38, 0.5);
    transition: all 0.2s ease;
  }
  .extreme-cta-btn:hover {
    border-color: #22c55e;
    box-shadow: 0 0 30px rgba(34, 197, 94, 0.7);
    transform: scale(1.03);
    color: #fff;
  }

  /* Stats Grid (Half Dracula Red, Half Zombie Green) */
  .james-stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 1rem;
    margin-bottom: 2.75rem;
  }

  .stat-box {
    background: #09090d;
    border: 2px solid #27272a;
    padding: 1.25rem 1.4rem;
    display: flex;
    flex-direction: column;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.7);
  }

  .stat-box.dracula-stat {
    border-left: 5px solid #dc2626;
    border-top: 1px solid #7f1d1d;
  }
  .stat-box.dracula-stat .stat-num {
    color: #ef4444;
    text-shadow: 0 0 12px rgba(239, 68, 68, 0.6);
  }

  .stat-box.zombie-stat {
    border-left: 5px solid #22c55e;
    border-top: 1px solid #14532d;
  }
  .stat-box.zombie-stat .stat-num {
    color: #22c55e;
    text-shadow: 0 0 12px rgba(34, 197, 94, 0.6);
  }

  .stat-num {
    font-family: var(--font-display);
    font-size: 1.85rem;
    font-weight: 900;
    line-height: 1.1;
    margin-bottom: 0.35rem;
  }

  .stat-label {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #94a3b8;
  }

  /* Interactive Generator Card */
  .generator-card {
    background: #0a0407;
    border: 2px solid #dc2626;
    padding: 1.8rem;
    box-shadow: 0 0 35px rgba(220, 38, 38, 0.25);
    margin-bottom: 1.5rem;
  }

  .generator-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 1.25rem;
  }

  .generator-badge {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    color: #ef4444;
    display: block;
    margin-bottom: 0.25rem;
    text-shadow: 0 0 8px #dc2626;
  }

  .generator-title {
    font-family: var(--font-display);
    font-size: 1.45rem;
    margin: 0;
    font-weight: 800;
    color: #f8fafc;
  }

  .extreme-roll-btn {
    background: linear-gradient(135deg, #dc2626 0%, #16a34a 100%);
    border: 2px solid #fff;
    color: #fff;
    font-family: var(--font-mono);
    font-weight: 900;
    font-size: 0.85rem;
    padding: 0.8rem 1.5rem;
    clip-path: polygon(8px 0, 100% 0, calc(100% - 8px) 100%, 0 100%);
    cursor: pointer;
    box-shadow: 0 0 20px rgba(255, 255, 255, 0.4);
    transition: all 0.15s;
  }
  .extreme-roll-btn:hover {
    transform: scale(1.04);
    box-shadow: 0 0 30px #22c55e;
  }

  .random-fact-box {
    background: #040806;
    border: 1px dashed #22c55e;
    padding: 1.4rem 1.6rem;
    transition: all 0.2s ease;
  }

  .fact-quote {
    font-size: 1.1rem;
    font-style: italic;
    color: #86efac;
    margin: 0 0 0.5rem;
    line-height: 1.55;
    text-shadow: 0 0 8px rgba(34, 197, 94, 0.4);
  }

  .fact-attribution {
    font-family: var(--font-mono);
    font-size: 0.84rem;
    color: #94a3b8;
    margin: 0;
    text-align: right;
  }

  /* Serrated Jagged Section Divider */
  .jagged-divider {
    height: 18px;
    width: 100%;
    background: repeating-linear-gradient(
      -45deg,
      #dc2626,
      #dc2626 10px,
      #040507 10px,
      #040507 20px,
      #22c55e 20px,
      #22c55e 30px
    );
    border-top: 1px solid #7f1d1d;
    border-bottom: 1px solid #14532d;
    margin: 2rem 0;
  }

  /* Filter Navigation */
  .dossiers-section {
    padding: 1.5rem 0 4rem;
  }

  .section-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    flex-wrap: wrap;
    gap: 1.25rem;
    margin-bottom: 2rem;
  }

  .section-title {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 3.5vw, 2.2rem);
    margin: 0.2rem 0 0;
    font-weight: 900;
    color: #f8fafc;
    letter-spacing: -0.01em;
  }

  .filter-group {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .filter-btn {
    background: #09090d;
    border: 1px solid #27272a;
    color: #94a3b8;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    font-weight: 800;
    padding: 0.5rem 1rem;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .filter-btn:hover {
    color: #fff;
    border-color: #ef4444;
  }

  .filter-btn.active {
    background: linear-gradient(135deg, #dc2626 0%, #16a34a 100%);
    border-color: #fff;
    color: #fff;
    box-shadow: 0 0 15px rgba(255, 255, 255, 0.4);
  }

  /* Dossier Cards (Dracula vs Zombie) */
  .james-grid {
    display: grid;
    gap: 1.75rem;
    margin-bottom: 3.5rem;
  }

  .james-card {
    display: flex;
    flex-direction: column;
    padding: 1.75rem;
    background: #09090e;
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .james-card:hover {
    transform: translateY(-4px) scale(1.01);
  }

  /* Dracula Cards: Black, White, Red with Blood Glow */
  .card-dracula {
    border-left: 6px solid #dc2626;
    border-top: 1px solid #7f1d1d;
  }
  .card-dracula:hover {
    border-color: #ef4444;
    box-shadow: 0 10px 35px -5px rgba(220, 38, 38, 0.5), inset 0 0 15px rgba(220, 38, 38, 0.1);
  }

  /* Zombie Cards: Toxic Radioactive Slime */
  .card-zombie {
    border-left: 6px solid #22c55e;
    border-top: 1px solid #14532d;
  }
  .card-zombie:hover {
    border-color: #22c55e;
    box-shadow: 0 10px 35px -5px rgba(34, 197, 94, 0.5), inset 0 0 15px rgba(34, 197, 94, 0.1);
  }

  /* Hybrid Card: Dual Dracula / Zombie */
  .card-hybrid {
    border-left: 6px solid #dc2626;
    border-right: 6px solid #22c55e;
    border-top: 2px solid #fff;
  }
  .card-hybrid:hover {
    box-shadow: -8px 0 35px rgba(220, 38, 38, 0.6), 8px 0 35px rgba(34, 197, 94, 0.6);
  }

  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .header-left {
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }

  .country-flag {
    font-size: 1.8rem;
    line-height: 1;
  }

  .james-name {
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 800;
    margin: 0 0 0.2rem;
    line-height: 1.2;
  }

  .james-name-link {
    color: #f8fafc;
    text-decoration: none;
    transition: color 0.15s ease;
  }
  .card-dracula .james-name-link:hover { color: #ef4444; }
  .card-zombie .james-name-link:hover { color: #22c55e; }
  .card-hybrid .james-name-link:hover { color: #fff; }

  .james-meta {
    font-family: var(--font-mono);
    font-size: 0.76rem;
    color: #94a3b8;
    margin: 0;
  }

  .status-pill {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    padding: 0.3rem 0.75rem;
    white-space: nowrap;
  }

  .pill-dracula {
    background: rgba(220, 38, 38, 0.18);
    color: #ef4444;
    border: 1px solid #dc2626;
    box-shadow: 0 0 8px rgba(220, 38, 38, 0.4);
  }

  .pill-zombie {
    background: rgba(34, 197, 94, 0.18);
    color: #22c55e;
    border: 1px solid #16a34a;
    box-shadow: 0 0 8px rgba(34, 197, 94, 0.4);
  }

  .pill-hybrid {
    background: linear-gradient(135deg, rgba(220, 38, 38, 0.3), rgba(34, 197, 94, 0.3));
    color: #fff;
    border: 1px solid #fff;
    box-shadow: 0 0 12px rgba(255, 255, 255, 0.5);
  }

  .james-role-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    background: #0f131a;
    padding: 0.4rem 0.85rem;
    font-size: 0.82rem;
    font-weight: 700;
    color: #f1f5f9;
    margin-bottom: 1rem;
    width: fit-content;
    clip-path: polygon(6px 0, 100% 0, calc(100% - 6px) 100%, 0 100%);
  }
  .badge-dracula { border-left: 3px solid #ef4444; }
  .badge-zombie { border-left: 3px solid #22c55e; }
  .badge-hybrid { border-left: 3px solid #ef4444; border-right: 3px solid #22c55e; }

  .role-icon {
    font-size: 0.95rem;
  }

  .james-summary {
    font-size: 0.96rem;
    color: #cbd5e1;
    line-height: 1.6;
    margin: 0 0 1.25rem;
    flex: 1;
  }

  .fact-highlight {
    padding: 0.95rem 1.15rem;
    margin-bottom: 1.25rem;
  }

  .fact-dracula {
    background: rgba(220, 38, 38, 0.08);
    border-left: 4px solid #dc2626;
    border-bottom: 1px solid rgba(220, 38, 38, 0.3);
  }
  .fact-dracula .fact-title { color: #ef4444; }

  .fact-zombie {
    background: rgba(34, 197, 94, 0.08);
    border-left: 4px solid #22c55e;
    border-bottom: 1px solid rgba(34, 197, 94, 0.3);
  }
  .fact-zombie .fact-title { color: #22c55e; }

  .fact-hybrid {
    background: linear-gradient(90deg, rgba(220, 38, 38, 0.1), rgba(34, 197, 94, 0.1));
    border-left: 4px solid #dc2626;
    border-right: 4px solid #22c55e;
  }
  .fact-hybrid .fact-title { color: #f8fafc; }

  .fact-title {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 0.35rem;
  }

  .fact-body {
    font-size: 0.88rem;
    line-height: 1.5;
    color: #e2e8f0;
    margin: 0;
  }

  .james-quote {
    font-style: italic;
    font-size: 0.88rem;
    color: #94a3b8;
    border: none;
    padding: 0;
    margin: 0 0 1.25rem;
    line-height: 1.45;
  }

  .card-footer-action {
    border-top: 1px solid #1e293b;
    padding-top: 0.95rem;
    margin-top: auto;
  }

  .card-linkedin-link {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 700;
    color: #94a3b8;
    text-decoration: none;
    transition: color 0.15s ease;
  }
  .card-dracula .card-linkedin-link:hover { color: #ef4444; text-shadow: 0 0 8px #ef4444; }
  .card-zombie .card-linkedin-link:hover { color: #22c55e; text-shadow: 0 0 8px #22c55e; }
  .card-hybrid .card-linkedin-link:hover { color: #fff; text-shadow: 0 0 8px #fff; }

  /* Dispatch Box */
  .james-dispatch-box {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1.5rem;
    background: linear-gradient(135deg, rgba(220, 38, 38, 0.15) 0%, #09090e 50%, rgba(34, 197, 94, 0.15) 100%);
    border: 2px solid #3f3f46;
    padding: 2.2rem;
    box-shadow: -4px 0 25px rgba(220, 38, 38, 0.3), 4px 0 25px rgba(34, 197, 94, 0.3);
  }

  .dispatch-content {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    max-width: 36rem;
  }

  .dispatch-icon {
    font-size: 2.8rem;
    line-height: 1;
    filter: drop-shadow(0 0 10px #facc15);
  }

  .dispatch-content h3 {
    font-family: var(--font-display);
    font-size: 1.4rem;
    margin: 0 0 0.35rem;
    color: #f8fafc;
