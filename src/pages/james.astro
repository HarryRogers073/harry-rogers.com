    -webkit-text-fill-color: transparent;
    text-decoration: none;
    display: inline-block;
    transition: opacity 0.15s ease;
  }
  .dracula-zombie-name-link:hover {
    opacity: 0.9;
  }

  /* Profile Highlight Card with Dual Glow */
  .profile-highlight-box {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 1.5rem 1.75rem;
    margin-bottom: 2rem;
    box-shadow: -3px 0 20px rgba(220, 38, 38, 0.12), 3px 0 20px rgba(34, 197, 94, 0.12);
  }

  .profile-header-split {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1.5rem;
  }

  .profile-text-side {
    max-width: 48rem;
