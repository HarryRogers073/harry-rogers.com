  <script is:inline define:vars={{ dossiersJson: JSON.stringify(jamesDossiers), LINKEDIN_URL }}>
    const dossiers = JSON.parse(dossiersJson);

    // 1. Violent Lightning Flash Strobe
    const strobeBtn = document.getElementById('strobe-btn');
    const flashOverlay = document.getElementById('lightning-flash-overlay');
    const rootEl = document.getElementById('extreme-root');

    function triggerLightning() {
      if (!flashOverlay) return;
      flashOverlay.classList.remove('active-flash');
      void flashOverlay.offsetWidth; // trigger reflow
      flashOverlay.classList.add('active-flash');

      if (rootEl) {
        rootEl.classList.add('violent-rumble');
        setTimeout(() => rootEl.classList.remove('violent-rumble'), 400);
      }
    }

    if (strobeBtn) {
      strobeBtn.addEventListener('click', triggerLightning);
    }

    // 2. Fact Generator Logic with Screen Shake
    const rollBtn = document.getElementById('roll-fact-btn');
    const quoteEl = document.getElementById('fact-quote');
    const attrEl = document.getElementById('fact-attribution');
    const factBox = document.getElementById('random-fact-display');

    if (rollBtn && quoteEl && attrEl && factBox) {
      let lastIndex = -1;

      rollBtn.addEventListener('click', () => {
        triggerLightning();

        let nextIndex;
        do {
          nextIndex = Math.floor(Math.random() * dossiers.length);
        } while (nextIndex === lastIndex && dossiers.length > 1);
        lastIndex = nextIndex;

        const picked = dossiers[nextIndex];
        
        factBox.style.opacity = '0.2';
        factBox.style.transform = 'translateY(6px) scale(0.98)';

        setTimeout(() => {
          quoteEl.innerHTML = `“${picked.funFact}”`;
          const factionColor = picked.faction === 'dracula' ? '#ef4444' : (picked.faction === 'zombie' ? '#22c55e' : '#a855f7');
          attrEl.innerHTML = `— <a href="${LINKEDIN_URL}" target="_blank" rel="noopener" style="color:${factionColor}; text-decoration:underline;"><strong>${picked.name}</strong></a> (${picked.location}, ${picked.era})`;
          factBox.style.opacity = '1';
          factBox.style.transform = 'translateY(0) scale(1)';
        }, 150);
      });
    }

    // 3. Faction Filtering Logic
    const filterBtns = document.querySelectorAll('.filter-btn');
    const cards = document.querySelectorAll('.james-card');

    filterBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        filterBtns.forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');

        const filterVal = btn.dataset.filter;

        cards.forEach((card) => {
          if (filterVal === 'all' || card.dataset.faction === filterVal) {
            card.style.display = 'flex';
          } else {
            card.style.display = 'none';
          }
        });
      });
    });
  </script>
