    const quoteEl = document.getElementById('feed-quote');
    const attrEl = document.getElementById('feed-attribution');
    const feedBox = document.getElementById('terminal-feed-box');

    if (queryBtn && quoteEl && attrEl && feedBox) {
      let lastIndex = -1;

      queryBtn.addEventListener('click', () => {
        let nextIndex;
        do {
          nextIndex = Math.floor(Math.random() * dossiers.length);
        } while (nextIndex === lastIndex && dossiers.length > 1);
        lastIndex = nextIndex;

        const record = dossiers[nextIndex];

