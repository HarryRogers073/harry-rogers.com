    let osc = null;
    let gain = null;
    let isHumming = false;

    const audioBtn = document.getElementById('audio-toggle');
    const dot = document.getElementById('audio-status-dot');
    const text = document.getElementById('audio-text');

    if (audioBtn) {
      audioBtn.addEventListener('click', () => {
        if (!isHumming) {
          try {
            audioCtx = new (window.AudioContext || window.webkitAudioContext)();
            osc = audioCtx.createOscillator();
            gain = audioCtx.createGain();

            osc.type = 'triangle';
            osc.frequency.setValueAtTime(55, audioCtx.currentTime); // Low 55Hz bass ground loop

            const filter = audioCtx.createBiquadFilter();
            filter.type = 'lowpass';
            filter.frequency.setValueAtTime(90, audioCtx.currentTime);

            gain.gain.setValueAtTime(0.025, audioCtx.currentTime);

            osc.connect(filter);
            filter.connect(gain);
            gain.connect(audioCtx.destination);

            osc.start();
            isHumming = true;
            if (dot) dot.style.background = '#38bdf8';
            if (text) text.textContent = 'AMBIENCE: ON';
          } catch (e) {
            console.warn('Audio unavailable', e);
          }
        } else {
          if (osc) osc.stop();
          if (audioCtx) audioCtx.close();
          isHumming = false;
          if (dot) dot.style.background = '#71717a';
          if (text) text.textContent = 'BASS AMBIENCE';
        }
      });
    }

    // 4. Filter Switcher
    const filterBtns = document.querySelectorAll('.registry-filter-bar .filter-btn');
    const cards = document.querySelectorAll('.dossier-card');

    filterBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        filterBtns.forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');

        const val = btn.dataset.filter;
        cards.forEach((card) => {
          if (val === 'all' || card.dataset.period === val) {
            card.style.display = 'flex';
          } else {
            card.style.display = 'none';
          }
        });
      });
    });
  </script>
